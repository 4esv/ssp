<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ssp</AssemblyName>
    <RootNamespace>Ssp.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ssp</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ssp.Core\Ssp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- NOTE: `ssp run` checks ssp:part directives against this table. -->
    <EmbeddedResource Include="..\..\models\parts.toml" LogicalName="parts.toml" />
  </ItemGroup>
</Project>
