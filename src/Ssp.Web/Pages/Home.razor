@page "/"
@using Ssp.Web.Components
@inject ISimulationHost Host

<PageTitle>ssp</PageTitle>

<main class="home">
    <h1>ssp</h1>
    <p>The user draws a pedal circuit and presses Run.</p>
    <nav class="home-links">
        <a href="editor">Editor</a>
        <a href="gallery">Gallery</a>
    </nav>
    <Gallery Embedded="true" />
</main>

<footer class="home-versions">
    <pre>@string.Join("\n", versions)</pre>
</footer>

@code {
    IReadOnlyList<string> versions = [];

    protected override async Task OnInitializedAsync() => versions = await Host.Versions();
}
