@page "/"
@using Ssp.Web.Components
@inject ISimulationHost Host

<PageTitle>ssp: design and simulate guitar pedal circuits</PageTitle>

<main class="home">
    <h1>ssp</h1>
    <p>ssp designs and simulates guitar pedal circuits in your browser. Draw a schematic or write a netlist, press Run, and read the gain, the frequency response and the clipping of the stage. It uses the SpiceSharp engine, the same engine as the command line tool, and it sends no circuit to a server.</p>
    <nav class="home-links">
        <a href="editor">Editor</a>
        <a href="gallery">Gallery</a>
        <a href="docs/index.html" target="_top">Docs</a>
    </nav>
    <Gallery Embedded="true" />
</main>

<footer class="home-versions">
    <pre>@string.Join("\n", versions)</pre>
</footer>

@code {
    IReadOnlyList<string> versions = [];

    protected override async Task OnInitializedAsync() => versions = await Host.Versions();
}
