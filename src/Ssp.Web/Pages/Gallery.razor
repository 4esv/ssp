@page "/gallery"
@using Ssp.Web.Library
@using Ssp.Web.Sharing

@if (!Embedded)
{
    <PageTitle>ssp gallery</PageTitle>
    <h1>Gallery</h1>
}
else
{
    <h2>Starter circuits</h2>
}

<ul class="gallery">
    @foreach (var circuit in CircuitLibrary.All)
    {
        <li>
            <a href="@("editor#" + ShareCodec.Encode(circuit.Netlist))">@circuit.Title</a>
            <figure class="preview" aria-hidden="true">
                <img src="@("previews/" + Path.ChangeExtension(circuit.FileName, ".svg"))" alt="" loading="lazy" />
            </figure>
            <span class="file">@circuit.FileName</span>
        </li>
    }
</ul>

@code {
    /// <summary>True on the home page: the list shows under a smaller heading, and the page title stays.</summary>
    [Parameter] public bool Embedded { get; set; }
}
