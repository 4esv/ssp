@page "/editor"
@using Microsoft.JSInterop
@using Ssp.Core
@using Ssp.Core.Analysis
@using Ssp.Core.Netlist
@using Ssp.Web.Docking
@using Ssp.Web.Editing
@using Ssp.Web.Projects
@using Ssp.Web.Schematic
@using Ssp.Web.Sharing
@using LayoutDoc = Ssp.Core.Layout.Layout
@inject ISimulationHost Host
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject TimeProvider Time
@implements IDisposable

<PageTitle>ssp editor</PageTitle>

<h1 class="editor-title">Editor</h1>

<div class="editor" tabindex="-1" @ref="root" @onkeydown="Hotkey" data-sheet="@sheet">
<CascadingValue Value="loads" IsFixed="true">
@if (RunErrors().ToList() is { Count: > 0 } errors)
{
    <ul class="run-errors" role="alert">
        @foreach (var d in errors)
        {
            <li class="error">The run stopped. @d.Message@(d.Line is int line ? $" (netlist line {line})" : "")</li>
        }
    </ul>
}

<CommandPalette Mode="mode" Chosen="Choose" />

<ProjectBar Store="store" Current="project" State="@saveState" Starter="@Starter()" Open="OpenProject" Rename="Rename" Export="Export" />

<DockLayout Default="DefaultLayout" StorageKey="ssp.dock.editor.v2">
    <DockPanel Id="text" Title="Netlist">
        <textarea @bind="netlist" @bind:event="oninput" @bind:after="Typed" rows="16" cols="80" spellcheck="false" aria-label="Netlist"></textarea>
    </DockPanel>

    <DockPanel Id="schematic" Title="Schematic">
        <SchematicEditor Netlist="@drawn" Layout="schematicLayout" Changed="Edit" NodeVoltages="@result?.OperatingPoint?.NodeVoltages" Stale="@stale" Pointed="Point">
            <Actions>
                <div class="toolbar" role="toolbar" aria-label="Editor actions">
                    <button type="button" class="run" title="Run (Ctrl+Enter or Cmd+Enter)" @onclick="Run" disabled="@running">Run</button>
                    <button type="button" class="undo" disabled="@(!history.CanUndo)" @onclick="Undo">Undo</button>
                    <button type="button" class="redo" disabled="@(!history.CanRedo)" @onclick="Redo">Redo</button>
                    @* NOTE: The rarely used actions share one menu, so the tool row fits at laptop widths. The buttons stay in the page and the CSS shows them while the menu is open. *@
                    <span class="export-menu@(exportOpen ? " open" : "")" @onkeydown="ExportKey">
                        <button type="button" class="export-toggle" aria-haspopup="true" aria-expanded="@(exportOpen ? "true" : "false")" title="Share, download and the parts list" @onclick="() => exportOpen = !exportOpen">Export</button>
                        <span class="export-items" role="group" aria-label="Export" @onclick="() => exportOpen = false">
                            <button type="button" class="share" title="Copy a link that holds this netlist" @onclick="Share">Share link</button>
                            <SchematicExport @ref="export" Netlist="@drawn" />
                        </span>
                    </span>
                    @* NOTE: The line has a fixed width, so the marker and the failure text move nothing beside it. *@
                    <span class="live-line">
                        <span class="live-state@(stale ? " stale" : "")" role="status">@LiveText()</span>
                        @if (liveFailure is not null)
                        {
                            <span class="live-failed" role="alert" title="@liveFailure">The last edit does not solve. @liveFailure The results are from the last good run.</span>
                        }
                    </span>
                    <span class="toolbar-status" role="status">@toolbarStatus</span>
                    <span class="toolbar-hint">Search actions: Ctrl+K or Cmd+K. Shortcuts: ?</span>
                </div>
            </Actions>
        </SchematicEditor>
    </DockPanel>

    <DockPanel Id="dc" Title="DC overlay">
        <DcOverlay OperatingPoint="@result?.OperatingPoint" Stale="@stale" />
    </DockPanel>

    <DockPanel Id="knobs" Title="Knobs">
        <Knobs Netlist="@netlist" NetlistChanged="Retune" />
    </DockPanel>

    <DockPanel Id="calculators" Title="Calculators">
        <CalculatorPanel Netlist="@drawn" Layout="schematicLayout" Changed="Edit" />
    </DockPanel>

    <DockPanel Id="results" Title="Results">
        @if (shareError is null && result is null)
        {
            <p class="panel-hint">Press Run to solve the circuit. Diagnostics and node voltages show here.</p>
        }

        @if (shareError is not null)
        {
            <ul class="diagnostics">
                <li class="@Class(shareError.Severity)">@shareError.Severity: @shareError.Message</li>
            </ul>
        }

        @if (result is not null)
        {
            <ul class="diagnostics">
                @foreach (var d in result.Diagnostics)
                {
                    <li class="@Class(d.Severity)">@d.Severity@(d.Line is int line ? $" (line {line})" : ""): @d.Message</li>
                }
            </ul>

            @if (result.OperatingPoint is null)
            {
                <p class="panel-hint">No node voltages. Fix the errors above, then press Run.</p>
            }

            @if (result.OperatingPoint is { } op)
            {
                <table class="voltages">
                    <thead><tr><th>Node</th><th>Voltage</th></tr></thead>
                    <tbody>
                        @foreach (var (node, volts) in op.NodeVoltages.Where(kv => kv.Key != Ground).OrderBy(kv => kv.Key, StringComparer.Ordinal))
                        {
                            <tr data-node="@node" class="@(pointed.Contains(node) ? "pointed" : null)"><td>@node</td><td>@Volts(volts)</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
    </DockPanel>

    <DockPanel Id="plots" Title="Plots">
        @if (result is null)
        {
            <p class="panel-hint">Run to plot. Frequency response, impedance and noise show here.</p>
        }
        else if (result.FrequencyResponse is null && result.Impedance is null && result.Noise is null)
        {
            <p class="panel-hint">This run gave no plots. Fix the errors in Results, then press Run.</p>
        }

        @if (result is not null)
        {
            @if (result.FrequencyResponse is { } ac)
            {
                <section class="bode">
                    <h2>Frequency response</h2>
                    <LineChart X="ac.Frequencies" Series="WithoutGround(ac.MagnitudeDb)" LogX="true" XLabel="Frequency" XUnit="Hz" YLabel="Magnitude" YUnit="dB" />
                    <LineChart X="ac.Frequencies" Series="WithoutGround(ac.PhaseDegrees)" LogX="true" XLabel="Frequency" XUnit="Hz" YLabel="Phase" YUnit="°" />
                </section>
            }

            @if (result.Impedance is { } z)
            {
                <section class="impedance">
                    <h2>Impedance</h2>
                    <LineChart X="z.Frequencies" Series="Magnitudes(z)" LogX="true" LogY="true" XLabel="Frequency" XUnit="Hz" YLabel="Impedance" YUnit="Ω" />
                </section>
            }

            @if (result.Noise is { } noise)
            {
                <section class="noise">
                    <h2>Noise</h2>
                    <LineChart X="noise.Frequencies" Series="Density(noise)" LogX="true" LogY="true" XLabel="Frequency" XUnit="Hz" YLabel="Noise density" YUnit="V/√Hz" />
                </section>
            }
        }
    </DockPanel>

    <DockPanel Id="compare" Title="Compare">
        <Compare Netlist="@drawn" />
    </DockPanel>

    <DockPanel Id="clip" Title="Clip">
        <ClipPlayer @ref="clipPlayer" Netlist="@netlist" />
    </DockPanel>

    <DockPanel Id="monitor" Title="Monitor">
        <LiveMonitor Netlist="@netlist" />
    </DockPanel>

    <DockPanel Id="amp" Title="Virtual amp">
        <VirtualAmp Pedal="@netlist" />
    </DockPanel>
</DockLayout>

@* NOTE: On a narrow screen the schematic is the whole screen. This bar opens one other panel over it. *@
<nav class="panel-bar" aria-label="Panels">
    @foreach (var (id, title) in SheetPanels)
    {
        <button type="button" data-panel="@id" aria-pressed="@(sheet == id ? "true" : "false")" @onclick="() => Sheet(id)">@title</button>
    }
</nav>
</CascadingValue>
</div>

@code {
    // NOTE: Node 0 is the ground reference. It is always 0 V, so the table leaves it out.
    const string Ground = "0";

    string netlist = "";
    LayoutDoc? schematicLayout;

    // NOTE: The panels that load the netlist show the drawn netlist. It follows the box when the typing stops for
    // DrawDebounce, so a key in the box does not redraw the schematic. The panels share one load of each netlist.
    static readonly TimeSpan DrawDebounce = TimeSpan.FromMilliseconds(100);
    readonly NetlistCache loads = new();
    string drawn = "";
    string? drawnShape;
    ITimer? drawTimer;
    readonly CommandStack history = new();
    bool running;
    ClipPlayer? clipPlayer;
    SchematicExport? export;
    ElementReference root;
    IJSObjectReference? keys;
    CommandPalette.PaletteMode mode;
    RunResult? result;
    Diagnostic? shareError;
    string toolbarStatus = "";

    // NOTE: A run follows each edit after this wait. Stale is true from the edit until a solve ends, and after a solve that failed.
    static readonly TimeSpan LiveDebounce = TimeSpan.FromMilliseconds(250);
    CancellationTokenSource? live;
    ITimer? liveTimer;
    bool stale;
    string? liveFailure;

    // NOTE: The schematic is the largest cell. The other panels are tabs in one strip at the side and one strip under it.
    public static DockModel DefaultLayout() => new(new DockSplit(SplitDirection.Row,
    [
        new DockSplit(SplitDirection.Column, [new DockTabs(["schematic"]), new DockTabs(["results", "plots", "dc", "monitor", "amp"])], [0.8, 0.2]),
        new DockTabs(["text", "knobs", "calculators", "compare", "clip"]),
    ], [0.72, 0.28]));

    static readonly (string Id, string Title)[] SheetPanels =
    [
        ("text", "Netlist"), ("knobs", "Knobs"), ("results", "Results"), ("plots", "Plots"), ("calculators", "Calculators"),
        ("dc", "DC"), ("compare", "Compare"), ("clip", "Clip"), ("monitor", "Monitor"), ("amp", "Amp"),
    ];

    // The panel that the narrow bar has open, or null.
    string? sheet;

    void Sheet(string id) => sheet = sheet == id ? null : id;

    // The nodes under the pointer on the schematic. Their rows in Results are marked.
    IReadOnlyCollection<string> pointed = [];

    void Point(IReadOnlyCollection<string> nodes) => pointed = nodes;

    IEnumerable<Diagnostic> RunErrors() => result?.Diagnostics.Where(d => d.Severity == Severity.Error) ?? [];

    // NOTE: Every key comes from Shortcuts.All, the table the palette and the sheet show.
    // A bare key and the undo keys belong to a field that has the focus.
    async Task Hotkey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Refocus(CommandPalette.PaletteMode.None);
            return;
        }
        if (Shortcuts.Find(e) is not { } shortcut || (shortcut.Bare || shortcut.Id is "undo" or "redo") && await Typing())
        {
            return;
        }
        await Choose(shortcut);
    }

    // NOTE: A closed dialog takes its focus with it, so the page div takes the focus back and the keys keep working.
    async Task Refocus(CommandPalette.PaletteMode next)
    {
        mode = next;
        if (next == CommandPalette.PaletteMode.None)
        {
            await root.FocusAsync();
        }
    }

    async Task Choose(Shortcut shortcut)
    {
        var previous = mode;
        await Refocus(CommandPalette.PaletteMode.None);
        switch (shortcut.Id)
        {
            case "run" when !running: await Run(); break;
            case "undo" when history.CanUndo: Undo(); break;
            case "redo" when history.CanRedo: Redo(); break;
            case "share": await Share(); break;
            case "svg" when export is not null: await export.Save(); break;
            case "palette": await Refocus(previous == CommandPalette.PaletteMode.Palette ? CommandPalette.PaletteMode.None : CommandPalette.PaletteMode.Palette); break;
            case "shortcuts": await Refocus(previous == CommandPalette.PaletteMode.Sheet ? CommandPalette.PaletteMode.None : CommandPalette.PaletteMode.Sheet); break;
        }
    }

    // NOTE: keys.js stops the browser acting on the table keys, and says whether a field has the focus.
    async Task<bool> Typing() => await (await KeysModule()).InvokeAsync<bool>("typing");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // NOTE: The key handler is on this div, so the div holds the focus until a control takes it.
                await root.FocusAsync();
                await (await KeysModule()).InvokeVoidAsync("guard", Shortcuts.All.Select(s => new { s.Key, s.Shift, s.Bare, Plain = s.Id is "undo" or "redo" }));
            }
            catch (Exception)
            {
                // NOTE: The guard is best effort. Without it the shortcuts still work, and the browser may also act on the key.
            }
        }
    }

    async Task<IJSObjectReference> KeysModule() => keys ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/keys.js");

    // NOTE: The address bar takes the link so it survives a clipboard that the browser denies.
    async Task Share()
    {
        Nav.NavigateTo(ShareHref);
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", Nav.ToAbsoluteUri(ShareHref).ToString());
            toolbarStatus = "Link copied.";
        }
        catch (JSException)
        {
            toolbarStatus = "Copy the link from the address bar.";
        }
    }

    string ShareHref => "editor#" + ShareCodec.Encode(netlist);

    protected override void OnInitialized()
    {
        store = new ProjectStore(new LocalStorage(Js), Time);
        var hash = new Uri(Nav.Uri).Fragment.TrimStart('#');
        fromLink = hash.Length > 0;
        project = ProjectStore.New(fromLink ? "Shared circuit" : "Untitled", "", null);
        if (!fromLink)
        {
            netlist = drawn = Starter();
            history.Reset(netlist, null);
            return;
        }
        try
        {
            netlist = drawn = ShareCodec.Decode(hash);
            history.Reset(netlist, null);
        }
        catch (FormatException e)
        {
            shareError = new Diagnostic(Severity.Error, e.Message, null);
        }
    }

    // NOTE: Without a shared link the editor opens the project that was open last. A shared link opens as a new
    // project. It is saved at its first edit, so it does not overwrite the open project.
    protected override async Task OnInitializedAsync()
    {
        if (fromLink)
        {
            return;
        }
        try
        {
            if (await store.OpenId() is { } id && await store.Load(id) is { } saved)
            {
                Apply(saved);
            }
        }
        catch (Exception)
        {
            // NOTE: Storage can be off or blocked. The starter circuit is then correct, so this is not an error.
        }
    }

    static string? starter;

    static string Starter()
    {
        if (starter is null)
        {
            using var reader = new StreamReader(typeof(Editor).Assembly.GetManifestResourceStream("starter.cir")!);
            starter = reader.ReadToEnd();
        }
        return starter;
    }

    // NOTE: Run plays the clip when the analyses finish. The render takes seconds, so the button is free again before it.
    async Task Run()
    {
        await Analyse();
        if (clipPlayer is not null && result is { } run && run.Diagnostics.All(d => d.Severity != Severity.Error))
        {
            await clipPlayer.Try(netlist);
        }
    }

    async Task Analyse()
    {
        CancelLive();
        shareError = null;
        toolbarStatus = "";
        running = true;
        result = await Host.Run(netlist, new RunOptions());
        running = false;
        stale = false;
        liveFailure = null;
    }

    string LiveText() => stale ? (liveFailure is null ? "Solving…" : "Stale") : "";

    void CancelLive()
    {
        liveTimer?.Dispose();
        liveTimer = null;
        live?.Cancel();
        live?.Dispose();
        live = null;
    }

    // NOTE: The run goes through the same host as the Run button. A failed solve keeps the last good result and marks it stale.
    void ScheduleLive()
    {
        CancelLive();
        stale = true;
        live = new CancellationTokenSource();
        var (text, token) = (netlist, live.Token);
        liveTimer = Time.CreateTimer(_ => _ = InvokeAsync(() => LiveRun(text, token)), null, LiveDebounce, Timeout.InfiniteTimeSpan);
    }

    async Task LiveRun(string text, CancellationToken token)
    {
        try
        {
            token.ThrowIfCancellationRequested();
            var run = Host.Run(text, new RunOptions());
            var solvedHere = run.IsCompleted;
            var next = await run;
            token.ThrowIfCancellationRequested();
            // NOTE: A solve on this thread and the render of its result are two tasks, so the browser draws a frame between them.
            if (solvedHere) await NextTask();
            await InvokeAsync(() =>
            {
                if (token.IsCancellationRequested)
                {
                    return;
                }
                var error = next.Diagnostics.FirstOrDefault(d => d.Severity == Severity.Error);
                if (error is null)
                {
                    result = next;
                    stale = false;
                    liveFailure = null;
                }
                else
                {
                    liveFailure = error.Message;
                }
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    Task NextTask()
    {
        var done = new TaskCompletionSource();
        ITimer? timer = null;
        timer = Time.CreateTimer(_ =>
        {
            timer?.Dispose();
            done.TrySetResult();
        }, null, TimeSpan.Zero, Timeout.InfiniteTimeSpan);
        return done.Task;
    }

    public void Dispose()
    {
        CancelLive();
        drawTimer?.Dispose();
        if (saveTimer is not null)
        {
            _ = SaveNow();
        }
    }

    // NOTE: Each edit saves the project after this wait, so a burst of edits is one write.
    static readonly TimeSpan SaveDebounce = TimeSpan.FromMilliseconds(500);
    ProjectStore store = default!;
    Project project = default!;
    // The name, the netlist and the layout text of the last save, or null before the first save.
    (string Name, string Netlist, string? Layout)? lastSaved;
    ITimer? saveTimer;
    bool fromLink;
    string saveState = "";

    void ScheduleSave()
    {
        saveState = "";
        saveTimer?.Dispose();
        saveTimer = Time.CreateTimer(_ => _ = InvokeAsync(async () =>
        {
            await SaveNow();
            StateHasChanged();
        }), null, SaveDebounce, Timeout.InfiniteTimeSpan);
    }

    async Task SaveNow()
    {
        saveTimer?.Dispose();
        saveTimer = null;
        (string Name, string Netlist, string? Layout) state = (project.Name, netlist, schematicLayout is null ? null : LayoutDoc.Format(schematicLayout));
        if (lastSaved == state)
        {
            return;
        }
        try
        {
            project = await store.Save(project with { Netlist = state.Netlist, Layout = state.Layout });
            await store.SetOpen(project.Id);
            lastSaved = state;
            saveState = "Saved";
        }
        catch (Exception)
        {
            saveState = "Not saved. Browser storage is off or full.";
            return;
        }
        LeaveLink();
    }

    // NOTE: After a shared link becomes a project, a reload opens the project and not the link again.
    void LeaveLink()
    {
        if (fromLink)
        {
            fromLink = false;
            Nav.NavigateTo("editor", replace: true);
        }
    }

    void Apply(Project next)
    {
        CancelLive();
        drawTimer?.Dispose();
        drawTimer = null;
        saveTimer?.Dispose();
        saveTimer = null;
        project = next;
        netlist = drawn = next.Netlist;
        schematicLayout = ReadLayout(next.Layout);
        drawnShape = ShapeOf(loads.Load(drawn));
        history.Reset(netlist, schematicLayout);
        result = null;
        shareError = null;
        stale = false;
        liveFailure = null;
        lastSaved = next.Saved == default ? null : (next.Name, next.Netlist, next.Layout);
    }

    // NOTE: A layout that does not read is left out. The schematic then places the parts again.
    static LayoutDoc? ReadLayout(string? text)
    {
        try
        {
            return text is null ? null : LayoutDoc.Parse(text);
        }
        catch (InvalidDataException)
        {
            return null;
        }
    }

    // NOTE: The open project is saved before the next one opens. A new or imported project is saved at once.
    async Task OpenProject(Project next)
    {
        if (saveTimer is not null)
        {
            await SaveNow();
        }
        Apply(next);
        LeaveLink();
        if (next.Saved == default)
        {
            await SaveNow();
            return;
        }
        try
        {
            await store.SetOpen(next.Id);
        }
        catch (Exception)
        {
            // NOTE: Storage can be blocked. The project is open until a reload.
        }
    }

    async Task Rename(string name)
    {
        project = project with { Name = name };
        await SaveNow();
    }

    async Task Export()
    {
        var name = string.Concat(project.Name.Select(c => Path.GetInvalidFileNameChars().Contains(c) || c is '/' or '\\' or ':' ? '_' : c));
        await using var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
        await module.InvokeVoidAsync("save", name + ".cir", "data:text/plain;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(netlist)));
    }

    // NOTE: A knob change runs the operating point and the frequency response again.
    async Task Retune(string tuned)
    {
        netlist = tuned;
        Draw();
        ScheduleSave();
        await Analyse();
    }

    void Typed()
    {
        ScheduleLive();
        ScheduleSave();
        drawTimer?.Dispose();
        drawTimer = Time.CreateTimer(_ => _ = InvokeAsync(() =>
        {
            Draw();
            StateHasChanged();
        }), null, DrawDebounce, Timeout.InfiniteTimeSpan);
    }

    // NOTE: A text edit that keeps the parts and their nodes (a value, a comment) keeps the layout. Any other text edit
    // keeps the places of the parts that stay, and places only the new parts. A netlist with errors changes nothing
    // until it is fixed. A text edit or a knob change is not in the history, so it clears the history.
    void Draw()
    {
        drawTimer?.Dispose();
        drawTimer = null;
        drawn = netlist;
        var circuit = loads.Load(drawn);
        if (ShapeOf(circuit) is { } shape)
        {
            if (shape != drawnShape && schematicLayout is not null) schematicLayout = AutoPlacer.Place(circuit, circuit.Directives, keep: schematicLayout);
            drawnShape = shape;
        }
        history.Reset(netlist, schematicLayout);
    }

    static string? ShapeOf(LoadedCircuit circuit) => circuit.Diagnostics.All(d => d.Severity != Severity.Error) ? AutoPlacer.Shape(circuit) : null;

    // NOTE: Each edit from the schematic editor and the calculator panel goes on the one history.
    void Edit(SchematicChange change)
    {
        history.Do(new ChangeCommand(change));
        Show();
    }

    bool exportOpen;

    void ExportKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") exportOpen = false;
    }

    void Undo()
    {
        history.Undo();
        Show();
    }

    void Redo()
    {
        history.Redo();
        Show();
    }

    void Show()
    {
        drawTimer?.Dispose();
        drawTimer = null;
        netlist = drawn = history.Netlist;
        schematicLayout = history.Layout;
        drawnShape = ShapeOf(loads.Load(drawn)) ?? drawnShape;
        ScheduleLive();
        ScheduleSave();
    }

    static string Class(Severity severity) => severity.ToString().ToLowerInvariant();

    static string Volts(double value) => Eng.Format(value, "V");

    static IReadOnlyDictionary<string, IReadOnlyList<double>> WithoutGround(IReadOnlyDictionary<string, IReadOnlyList<double>> series) =>
        series.Where(kv => kv.Key != Ground).OrderBy(kv => kv.Key, StringComparer.Ordinal).ToDictionary(kv => kv.Key, kv => kv.Value);

    static IReadOnlyDictionary<string, IReadOnlyList<double>> Magnitudes(ZResult z) => new Dictionary<string, IReadOnlyList<double>>
    {
        ["input"] = z.Input.Select(v => v.Magnitude).ToList(),
        ["output"] = z.Output.Select(v => v.Magnitude).ToList(),
    };

    static IReadOnlyDictionary<string, IReadOnlyList<double>> Density(NoiseResult noise) => new Dictionary<string, IReadOnlyList<double>>
    {
        ["output"] = noise.Density,
    };
}
