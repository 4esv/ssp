@page "/editor"
@using System.Globalization
@using Ssp.Core
@using Ssp.Core.Analysis
@using Ssp.Core.Netlist
@using Ssp.Web.Sharing
@inject ISimulationHost Host
@inject NavigationManager Nav

<PageTitle>ssp editor</PageTitle>

<h1>Editor</h1>

<div class="editor-split">
    <textarea @bind="netlist" @bind:event="oninput" rows="16" cols="80" spellcheck="false" aria-label="Netlist"></textarea>
    <SchematicView Netlist="@netlist" />
</div>

<button @onclick="Run" disabled="@running">Run</button>
<a class="share" href="@ShareHref">Share link</a>
<SchematicExport Netlist="@netlist" />

<Knobs Netlist="@netlist" NetlistChanged="Retune" />

@if (shareError is not null)
{
    <ul class="diagnostics">
        <li class="@Class(shareError.Severity)">@shareError.Severity: @shareError.Message</li>
    </ul>
}

@if (result is not null)
{
    <ul class="diagnostics">
        @foreach (var d in result.Diagnostics)
        {
            <li class="@Class(d.Severity)">@d.Severity@(d.Line is int line ? $" (line {line})" : ""): @d.Message</li>
        }
    </ul>

    @if (result.OperatingPoint is { } op)
    {
        <table class="voltages">
            <thead><tr><th>Node</th><th>Voltage</th></tr></thead>
            <tbody>
                @foreach (var (node, volts) in op.NodeVoltages.Where(kv => kv.Key != Ground).OrderBy(kv => kv.Key, StringComparer.Ordinal))
                {
                    <tr><td>@node</td><td>@Volts(volts)</td></tr>
                }
            </tbody>
        </table>
    }

    @if (result.FrequencyResponse is { } ac)
    {
        <section class="bode">
            <h2>Frequency response</h2>
            <LineChart X="ac.Frequencies" Series="WithoutGround(ac.MagnitudeDb)" LogX="true" XLabel="Frequency" XUnit="Hz" YLabel="Magnitude" YUnit="dB" />
            <LineChart X="ac.Frequencies" Series="WithoutGround(ac.PhaseDegrees)" LogX="true" XLabel="Frequency" XUnit="Hz" YLabel="Phase" YUnit="°" />
        </section>
    }

    @if (result.Impedance is { } z)
    {
        <section class="impedance">
            <h2>Impedance</h2>
            <LineChart X="z.Frequencies" Series="Magnitudes(z)" LogX="true" LogY="true" XLabel="Frequency" XUnit="Hz" YLabel="Impedance" YUnit="Ω" />
        </section>
    }

    @if (result.Noise is { } noise)
    {
        <section class="noise">
            <h2>Noise</h2>
            <LineChart X="noise.Frequencies" Series="Density(noise)" LogX="true" LogY="true" XLabel="Frequency" XUnit="Hz" YLabel="Noise density" YUnit="V/√Hz" />
        </section>
    }
}

<Compare Netlist="@netlist" />

@code {
    // NOTE: Node 0 is the ground reference. It is always 0 V, so the table leaves it out.
    const string Ground = "0";

    string netlist = "";
    bool running;
    RunResult? result;
    Diagnostic? shareError;

    string ShareHref => "editor#" + ShareCodec.Encode(netlist);

    protected override void OnInitialized()
    {
        var hash = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (hash.Length == 0)
        {
            return;
        }
        try
        {
            netlist = ShareCodec.Decode(hash);
        }
        catch (FormatException e)
        {
            shareError = new Diagnostic(Severity.Error, e.Message, null);
        }
    }

    async Task Run()
    {
        shareError = null;
        running = true;
        result = await Host.Run(netlist, new RunOptions());
        running = false;
    }

    // NOTE: A knob change runs the operating point and the frequency response again.
    async Task Retune(string tuned)
    {
        netlist = tuned;
        await Run();
    }

    static string Class(Severity severity) => severity.ToString().ToLowerInvariant();

    static string Volts(double value) => value.ToString("G4", CultureInfo.InvariantCulture) + " V";

    static IReadOnlyDictionary<string, IReadOnlyList<double>> WithoutGround(IReadOnlyDictionary<string, IReadOnlyList<double>> series) =>
        series.Where(kv => kv.Key != Ground).OrderBy(kv => kv.Key, StringComparer.Ordinal).ToDictionary(kv => kv.Key, kv => kv.Value);

    static IReadOnlyDictionary<string, IReadOnlyList<double>> Magnitudes(ZResult z) => new Dictionary<string, IReadOnlyList<double>>
    {
        ["input"] = z.Input.Select(v => v.Magnitude).ToList(),
        ["output"] = z.Output.Select(v => v.Magnitude).ToList(),
    };

    static IReadOnlyDictionary<string, IReadOnlyList<double>> Density(NoiseResult noise) => new Dictionary<string, IReadOnlyList<double>>
    {
        ["output"] = noise.Density,
    };
}
