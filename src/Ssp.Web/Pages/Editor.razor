@page "/editor"
@using System.Globalization
@using Ssp.Core
@using Ssp.Core.Analysis
@using Ssp.Core.Netlist
@using Ssp.Web.Docking
@using Ssp.Web.Editing
@using Ssp.Web.Schematic
@using Ssp.Web.Sharing
@using LayoutDoc = Ssp.Core.Layout.Layout
@inject ISimulationHost Host
@inject NavigationManager Nav

<PageTitle>ssp editor</PageTitle>

<h1>Editor</h1>

<button class="run" @onclick="Run" disabled="@running">Run</button>
<button type="button" class="undo" disabled="@(!history.CanUndo)" @onclick="Undo">Undo</button>
<button type="button" class="redo" disabled="@(!history.CanRedo)" @onclick="Redo">Redo</button>
<a class="share" href="@ShareHref">Share link</a>
<SchematicExport Netlist="@netlist" />

<DockLayout Default="DefaultLayout" StorageKey="ssp.dock.editor">
    <DockPanel Id="text" Title="Netlist">
        <textarea @bind="netlist" @bind:event="oninput" @bind:after="ResetLayout" rows="16" cols="80" spellcheck="false" aria-label="Netlist"></textarea>
    </DockPanel>

    <DockPanel Id="schematic" Title="Schematic">
        <SchematicEditor Netlist="@netlist" Layout="schematicLayout" Changed="Edit" />
    </DockPanel>

    <DockPanel Id="dc" Title="DC overlay">
        <DcOverlay OperatingPoint="@result?.OperatingPoint" />
    </DockPanel>

    <DockPanel Id="knobs" Title="Knobs">
        <Knobs Netlist="@netlist" NetlistChanged="Retune" />
    </DockPanel>

    <DockPanel Id="calculators" Title="Calculators">
        <CalculatorPanel Netlist="@netlist" Layout="schematicLayout" Changed="Edit" />
    </DockPanel>

    <DockPanel Id="results" Title="Results">
        @if (shareError is not null)
        {
            <ul class="diagnostics">
                <li class="@Class(shareError.Severity)">@shareError.Severity: @shareError.Message</li>
            </ul>
        }

        @if (result is not null)
        {
            <ul class="diagnostics">
                @foreach (var d in result.Diagnostics)
                {
                    <li class="@Class(d.Severity)">@d.Severity@(d.Line is int line ? $" (line {line})" : ""): @d.Message</li>
                }
            </ul>

            @if (result.OperatingPoint is { } op)
            {
                <table class="voltages">
                    <thead><tr><th>Node</th><th>Voltage</th></tr></thead>
                    <tbody>
                        @foreach (var (node, volts) in op.NodeVoltages.Where(kv => kv.Key != Ground).OrderBy(kv => kv.Key, StringComparer.Ordinal))
                        {
                            <tr><td>@node</td><td>@Volts(volts)</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
    </DockPanel>

    <DockPanel Id="plots" Title="Plots">
        @if (result is not null)
        {
            @if (result.FrequencyResponse is { } ac)
            {
                <section class="bode">
                    <h2>Frequency response</h2>
                    <LineChart X="ac.Frequencies" Series="WithoutGround(ac.MagnitudeDb)" LogX="true" XLabel="Frequency" XUnit="Hz" YLabel="Magnitude" YUnit="dB" />
                    <LineChart X="ac.Frequencies" Series="WithoutGround(ac.PhaseDegrees)" LogX="true" XLabel="Frequency" XUnit="Hz" YLabel="Phase" YUnit="°" />
                </section>
            }

            @if (result.Impedance is { } z)
            {
                <section class="impedance">
                    <h2>Impedance</h2>
                    <LineChart X="z.Frequencies" Series="Magnitudes(z)" LogX="true" LogY="true" XLabel="Frequency" XUnit="Hz" YLabel="Impedance" YUnit="Ω" />
                </section>
            }

            @if (result.Noise is { } noise)
            {
                <section class="noise">
                    <h2>Noise</h2>
                    <LineChart X="noise.Frequencies" Series="Density(noise)" LogX="true" LogY="true" XLabel="Frequency" XUnit="Hz" YLabel="Noise density" YUnit="V/√Hz" />
                </section>
            }
        }
    </DockPanel>

    <DockPanel Id="compare" Title="Compare">
        <Compare Netlist="@netlist" />
    </DockPanel>

    <DockPanel Id="clip" Title="Clip">
        <ClipPlayer @ref="clipPlayer" Netlist="@netlist" />
    </DockPanel>

    <DockPanel Id="amp" Title="Virtual amp">
        <VirtualAmp />
    </DockPanel>
</DockLayout>

@code {
    // NOTE: Node 0 is the ground reference. It is always 0 V, so the table leaves it out.
    const string Ground = "0";

    string netlist = "";
    LayoutDoc? schematicLayout;
    readonly CommandStack history = new();
    bool running;
    ClipPlayer? clipPlayer;
    RunResult? result;
    Diagnostic? shareError;

    // NOTE: The netlist and the schematic are side by side. The panels under them are tabs.
    static DockModel DefaultLayout() => new(new DockSplit(SplitDirection.Row,
    [
        new DockSplit(SplitDirection.Column, [new DockTabs(["text"]), new DockTabs(["knobs", "calculators", "compare", "clip", "amp"])], [0.55, 0.45]),
        new DockSplit(SplitDirection.Column, [new DockTabs(["schematic"]), new DockTabs(["results", "plots", "dc"])], [0.55, 0.45]),
    ]));

    string ShareHref => "editor#" + ShareCodec.Encode(netlist);

    protected override void OnInitialized()
    {
        var hash = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (hash.Length == 0)
        {
            return;
        }
        try
        {
            netlist = ShareCodec.Decode(hash);
            history.Reset(netlist, null);
        }
        catch (FormatException e)
        {
            shareError = new Diagnostic(Severity.Error, e.Message, null);
        }
    }

    // NOTE: Run plays the clip when the analyses finish. The render takes seconds, so the button is free again before it.
    async Task Run()
    {
        await Analyse();
        if (clipPlayer is not null && result is { } run && run.Diagnostics.All(d => d.Severity != Severity.Error))
        {
            await clipPlayer.Try(netlist);
        }
    }

    async Task Analyse()
    {
        shareError = null;
        running = true;
        result = await Host.Run(netlist, new RunOptions());
        running = false;
    }

    // NOTE: A knob change runs the operating point and the frequency response again.
    async Task Retune(string tuned)
    {
        netlist = tuned;
        history.Reset(netlist, schematicLayout);
        await Analyse();
    }

    // NOTE: A text edit can rename or remove parts, so the schematic goes back to the auto-placement.
    // A text edit or a knob change is not in the history, so it clears the history.
    void ResetLayout()
    {
        schematicLayout = null;
        history.Reset(netlist, null);
    }

    // NOTE: Each edit from the schematic editor and the calculator panel goes on the one history.
    void Edit(SchematicChange change)
    {
        history.Do(new ChangeCommand(change));
        Show();
    }

    void Undo()
    {
        history.Undo();
        Show();
    }

    void Redo()
    {
        history.Redo();
        Show();
    }

    void Show()
    {
        netlist = history.Netlist;
        schematicLayout = history.Layout;
    }

    static string Class(Severity severity) => severity.ToString().ToLowerInvariant();

    static string Volts(double value) => value.ToString("G4", CultureInfo.InvariantCulture) + " V";

    static IReadOnlyDictionary<string, IReadOnlyList<double>> WithoutGround(IReadOnlyDictionary<string, IReadOnlyList<double>> series) =>
        series.Where(kv => kv.Key != Ground).OrderBy(kv => kv.Key, StringComparer.Ordinal).ToDictionary(kv => kv.Key, kv => kv.Value);

    static IReadOnlyDictionary<string, IReadOnlyList<double>> Magnitudes(ZResult z) => new Dictionary<string, IReadOnlyList<double>>
    {
        ["input"] = z.Input.Select(v => v.Magnitude).ToList(),
        ["output"] = z.Output.Select(v => v.Magnitude).ToList(),
    };

    static IReadOnlyDictionary<string, IReadOnlyList<double>> Density(NoiseResult noise) => new Dictionary<string, IReadOnlyList<double>>
    {
        ["output"] = noise.Density,
    };
}
