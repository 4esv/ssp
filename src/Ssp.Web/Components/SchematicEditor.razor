@using Ssp.Web.Editing
@using System.Globalization
@using System.Text.RegularExpressions
@using Ssp.Core.Diagnostics
@using Ssp.Core.Netlist
@using Ssp.Core.Parts
@using Ssp.Web.Schematic
@using Ssp.Web.Library
@using Ssp.Web.Projects
@using SpiceComponent = SpiceSharp.Components.IComponent
@using LayoutDoc = Ssp.Core.Layout.Layout
@using Point = Ssp.Core.Layout.Point
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

<section class="schematic-editor">
    <div class="schematic-tools" role="toolbar" aria-label="Schematic tools">
        @Actions
        <div class="tool-group" role="group" aria-label="Parts">
            <span class="tool-label">Add a part</span>
            @foreach (var kind in SchematicEdits.Kinds.Keys)
            {
                <button type="button" class="place" data-kind="@kind" disabled="@hasErrors" @onclick="() => Place(kind)">@Label(kind)</button>
            }
        </div>
        <div class="tool-group" role="group" aria-label="Tools">
            <span class="tool-label">Connect</span>
            <button type="button" class="tool" data-tool="wire" aria-pressed="@Pressed(Tool.Wire)" @onclick="() => Select(Tool.Wire)">Wire</button>
            <button type="button" class="tool" data-tool="ground" aria-pressed="@Pressed(Tool.Ground)" @onclick="() => Select(Tool.Ground)">Ground</button>
        </div>
        <div class="tool-group" role="group" aria-label="Selection">
            <button type="button" class="tool" data-tool="select" aria-pressed="@(boxTool ? "true" : "false")" title="Drag a box to select parts. A tap on a part adds it or takes it out." @onclick="ToggleBox">Select</button>
            @* NOTE: Copy, Cut and Delete of a group are its actions on the canvas. Paste shows once there is a copy. *@
            @if (clip is not null)
            {
                <button type="button" class="tool" data-action="paste" disabled="@hasErrors" title="Paste (Ctrl+V or Cmd+V)" @onclick="PasteClip">Paste</button>
            }
        </div>
        <div class="tool-group" role="group" aria-label="Circuit">
            <button type="button" class="tool" data-action="new" title="Start an empty circuit. Undo brings the old one back." @onclick="NewCircuit">New</button>
        </div>
    </div>
    @* NOTE: The hint and the first steps share one line, so they take no height from the canvas. *@
    <div class="schematic-status">
        <p class="schematic-hint" role="status">@Hint()</p>
        @if (HintsLeft().Any())
        {
            <ul class="first-run-hints" aria-label="First steps">
                @foreach (var (id, text) in HintsLeft())
                {
                    <li data-hint="@id">@text</li>
                }
            </ul>
        }
    </div>
    @if (ValueBox())
    {
        <div class="value-edit-box">
            <input class="value-edit" type="text" inputmode="text" autocomplete="off" spellcheck="false" aria-label="Value of @selected"
                   aria-invalid="@(valueError is null ? null : "true")" value="@valueText"
                   @oninput="TypeValue"
                   @onkeydown="ValueKey" @onkeydown:stopPropagation />
        </div>
    }
    @if (NameBox() is { } net)
    {
        <div class="value-edit-box">
            <input class="value-edit net-name-edit" type="text" autocomplete="off" spellcheck="false" aria-label="Name of net @net" placeholder="Net name"
                   aria-invalid="@(nameError is null ? null : "true")" value="@nameText"
                   @oninput="TypeName"
                   @onkeydown="NameKey" @onkeydown:stopPropagation />
        </div>
        @if (nameError is not null)
        {
            <p class="value-error" role="alert">@nameError</p>
        }
    }
    @if (saving is not null)
    {
        <form class="block-save" @onsubmit="SaveBlock">
            <input class="block-name" type="text" autocomplete="off" spellcheck="false" aria-label="Name of the block" value="@savingName"
                   @oninput="e => savingName = e.Value?.ToString()" @onkeydown:stopPropagation />
            <button type="submit">Save block</button>
            <button type="button" @onclick="() => saving = null">Cancel</button>
        </form>
    }
    @if (valueError is not null && ValueBox())
    {
        <p class="value-error" role="alert">@valueError</p>
    }
    @if (undo is { } undoable)
    {
        <p class="delete-status" role="status">Deleted @undoable.Name. <button type="button" @onclick="Undo">Undo</button></p>
    }
    <div class="schematic-body">
    <div class="palette" role="group" aria-label="Parts palette">
        @foreach (var kind in SchematicEdits.Kinds.Keys)
        {
            <button type="button" class="palette-item" data-kind="@kind" disabled="@hasErrors"
                    title="Add a @Label(kind).ToLowerInvariant() at the centre of the canvas"
                    @onclick="() => PaletteAdd(kind)">
                <span class="palette-symbol">@((MarkupString)SymbolOf(kind))</span>
                <span class="palette-name">@Label(kind)</span>
            </button>
        }
        <button type="button" class="palette-item palette-blocks" data-action="blocks" disabled="@hasErrors" aria-expanded="@(blocksOpen ? "true" : "false")"
                aria-pressed="@(pick is null ? "false" : "true")" title="Insert a ready-made stage or one of My Blocks" @onclick="ToggleBlocks">
            <span class="palette-symbol" aria-hidden="true">&#x25A6;</span>
            <span class="palette-name">Blocks</span>
        </button>
    </div>
    @if (blocksOpen)
    {
        <div class="block-list" role="group" aria-label="Blocks">
            @if (myBlocks.Count > 0)
            {
                <p class="block-heading">My Blocks</p>
                @foreach (var b in myBlocks)
                {
                    var saved = b;
                    <button type="button" data-block="@("my:" + saved.Id)" @onclick="() => Pick(saved.Name, saved.Netlist, saved.Layout)">@saved.Name</button>
                }
            }
            <p class="block-heading">Stages</p>
            @foreach (var b in CircuitLibrary.Blocks)
            {
                var block = b;
                <button type="button" data-block="@block.FileName" @onclick="() => Pick(block.Title, block.Netlist, block.Layout)">@block.Title</button>
            }
        </div>
    }
    <figure class="schematic" aria-label="Schematic" tabindex="0" @ref="pane" data-view="@(view is null ? null : "")" style="@StageStyle()"
            @onkeydown="Key" @onkeydown:preventDefault="@(selected is not null || selectedWire is not null || active is not null || group.Count > 0)"
            @onwheel="Wheel" @onwheel:preventDefault @onclick="CanvasClick" @ondblclick="CanvasDoubleClick">
        @if (svg is null && !hasErrors)
        {
            <div class="schematic-blank">
                <p class="schematic-empty">Tap a part in the palette to start. Then tap a pin to see where to go next.</p>
            </div>
        }
        @if (svg is not null)
        {
            @((MarkupString)svg)
            <svg class="schematic-pins" xmlns="http://www.w3.org/2000/svg" viewBox="@viewBox"
                 @onpointerdown="PanDown" @onpointermove="PanMove" @onpointerup="PanUp" @onpointercancel="PanUp" @oncontextmenu:preventDefault>
                @for (var i = 0; i < layout.Wires.Count; i++)
                {
                    var wireIndex = i;
                    <polyline class="@(wireIndex == selectedWire ? "wire-hit selected" : "wire-hit")" data-wire="@wireIndex"
                              points="@WirePoints(layout.Wires[wireIndex])" @onclick="e => WireClick(wireIndex, e)" @onclick:stopPropagation @ondblclick:stopPropagation />
                }
                @foreach (var part in outlines)
                {
                    <rect class="@PartClass(part.Reference)" data-ref="@part.Reference"
                          x="@N(part.Min.X)" y="@N(part.Min.Y)" width="@N(part.Max.X - part.Min.X)" height="@N(part.Max.Y - part.Min.Y)"
                          @onpointerdown="e => PartDown(part.Reference, e)" @onpointermove="PartMove" @onpointerup="PartUp" @onpointercancel="PartUp"
                          @onclick="e => ClickPart(part.Reference, e)" @onclick:stopPropagation
                          @onpointerenter="() => PointAt(part.Reference, null)" @onpointerleave="PointAway">
                        <title>@PartText(part.Reference)</title>
                    </rect>
                }
                @if (moving is not null && ghost is { } g)
                {
                    @foreach (var m in Moving())
                    {
                        <rect class="part ghost" x="@N(m.Min.X + g.X)" y="@N(m.Min.Y + g.Y)" width="@N(m.Max.X - m.Min.X)" height="@N(m.Max.Y - m.Min.Y)" />
                    }
                }
                @if (boxing is { } client)
                {
                    var bx = (From: World(client.From), To: World(client.To));
                    <rect class="select-box" x="@N(Math.Min(bx.From.X, bx.To.X))" y="@N(Math.Min(bx.From.Y, bx.To.Y))"
                          width="@N(Math.Abs(bx.To.X - bx.From.X))" height="@N(Math.Abs(bx.To.Y - bx.From.Y))" />
                }
                @foreach (var lever in switches)
                {
                    var w = lever;
                    <g class="switch" data-ref="@w.Reference" data-position="@w.Position" role="button" tabindex="0" aria-label="@SwitchText(w)"
                       @onpointerdown:stopPropagation @onclick="() => Flip(w.Reference)" @onclick:stopPropagation
                       @onkeydown="e => SwitchKey(w, e)" @onkeydown:stopPropagation>
                        <circle class="switch-hit" cx="@N(w.At.X)" cy="@N(w.At.Y)" r="@N(Math.Max(SwitchHit, DotRadius()))" />
                        <title>@SwitchText(w). Tap to switch.</title>
                    </g>
                }
                @* NOTE: The hit circles of the pins lie under the knobs, and the pin dots above them, so a knob beside a pin does not cover the pin dot (#273). *@
                @foreach (var pin in pins)
                {
                    <circle class="pin-hit" data-ref="@pin.Ref.Reference" data-pin="@pin.Ref.Pin" cx="@N(pin.Position.X)" cy="@N(pin.Position.Y)" r="@N(PinHit())" @onclick="e => Click(pin.Ref, e)" @onclick:stopPropagation />
                }
                @foreach (var open in opens)
                {
                    var spot = new Spot(open);
                    <circle class="pin-hit" cx="@N(open.X)" cy="@N(open.Y)" r="@N(PinHit())" @onclick="() => Activate(spot)" @onclick:stopPropagation />
                }
                @foreach (var knob in knobs)
                {
                    var k = knob;
                    var shown = turning is { } t && t.Reference == k.Reference ? t.Now : k.Position;
                    var (px, py) = KnobPointer(k.At, shown, KnobFace());
                    <g class="@(turning?.Reference == k.Reference ? "knob turning" : "knob")" data-ref="@k.Reference" role="slider" tabindex="0"
                       aria-label="@k.Reference" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(shown * 100)" aria-valuetext="@KnobText(k, shown)"
                       @onpointerdown="e => KnobDown(k, e)" @onpointerdown:stopPropagation @onpointermove="KnobMove" @onpointermove:stopPropagation
                       @onpointerup="KnobUp" @onpointerup:stopPropagation @onpointercancel="KnobUp"
                       @onclick:stopPropagation @ondblclick="() => Turn(k.Reference, 0.5)" @ondblclick:stopPropagation
                       @onwheel="e => KnobWheel(k, e)" @onwheel:stopPropagation @onwheel:preventDefault
                       @onkeydown="e => KnobKey(k, e)" @onkeydown:stopPropagation>
                        <circle class="knob-hit" cx="@N(k.At.X)" cy="@N(k.At.Y)" r="@N(Math.Max(KnobFace(), DotRadius()))" />
                        <circle class="knob-face" cx="@N(k.At.X)" cy="@N(k.At.Y)" r="@N(KnobFace())" />
                        <line class="knob-pointer" x1="@N(k.At.X)" y1="@N(k.At.Y)" x2="@N(px)" y2="@N(py)" />
                        <title>@KnobText(k, shown). Drag, scroll or use the arrow keys. Double-click for noon.</title>
                    </g>
                }
                @foreach (var pin in pins)
                {
                    var target = connecting && pin.Ref != active?.Pin;
                    <circle class="@PinClass(pin)" data-ref="@pin.Ref.Reference" data-pin="@pin.Ref.Pin"
                            cx="@N(pin.Position.X)" cy="@N(pin.Position.Y)" r="@PinRadius(pin, target)" @onclick="e => Click(pin.Ref, e)" @onclick:stopPropagation
                            @onpointerenter="() => PointAt(pin.Ref.Reference, pin.Node)" @onpointerleave="PointAway">
                        <title>@pin.Ref.Reference pin @(pin.Ref.Pin + 1), @NodeText(pin.Node)</title>
                    </circle>
                }
                @foreach (var open in opens)
                {
                    var spot = new Spot(open);
                    <circle class="@(spot == active ? "pin open active" : "pin open")" data-open="@($"{N(open.X)},{N(open.Y)}")"
                            cx="@N(open.X)" cy="@N(open.Y)" r="5" @onclick="() => Activate(spot)" @onclick:stopPropagation>
                        <title>Open end</title>
                    </circle>
                }
                @foreach (var (node, at, text) in VoltageLabels())
                {
                    <g>
                        <text class="@(Stale ? "net-voltage stale" : "net-voltage")" data-node="@node" x="@N(at.X + 6)" y="@N(at.Y - 8)" font-size="10">@text</text>
                    </g>
                }
                @foreach (var jack in jacks)
                {
                    <g class="jack" data-jack="@jack.Label.ToLowerInvariant()" transform="translate(@N(jack.At.X) @N(jack.At.Y))">
                        @((MarkupString)SchematicRenderer.Inner("jack-" + jack.Label.ToLowerInvariant()))
                    </g>
                }
                @if (active is { } from && !connecting)
                {
                    @foreach (var d in free)
                    {
                        var (dot, dir) = (SchematicEdits.Toward(from.At, d), d);
                        <g class="@(chosen == d ? "pin-add chosen" : "pin-add")" data-dir="@dir.ToString().ToLowerInvariant()" role="button"
                           aria-label="Go @dir.ToString().ToLowerInvariant() from @Name(from)" @onclick="() => TapDot(dir)" @onclick:stopPropagation>
                            <circle class="pin-add-hit" cx="@N(dot.X)" cy="@N(dot.Y)" r="@N(DotRadius())" />
                            <circle class="pin-add-dot" cx="@N(dot.X)" cy="@N(dot.Y)" r="@N(Math.Min(DotRadius() * 0.55, VisibleDot))" />
                            <text class="pin-add-sign" x="@N(dot.X)" y="@N(dot.Y)" font-size="@N(Math.Min(DotRadius() * 0.55, VisibleDot) * 1.7)" text-anchor="middle" dominant-baseline="central">+</text>
                        </g>
                    }
                }
            </svg>
            @if (menuOpen && active is { } origin && chosen is { } way)
            {
                <div class="pin-menu" role="menu" @onclick:stopPropagation aria-label="Go @way.ToString().ToLowerInvariant() from @Name(origin)" style="@MenuStyle(origin, way)">
                    @foreach (var kind in SchematicEdits.Kinds.Keys)
                    {
                        <button type="button" role="menuitem" data-kind="@kind" @onclick="() => Choose(kind)">@Label(kind)</button>
                    }
                    <button type="button" role="menuitem" data-action="wire" @onclick="() => Choose(WireChoice)">Wire</button>
                    <button type="button" role="menuitem" data-action="ground" @onclick="() => Choose(GroundChoice)">Ground</button>
                    <button type="button" role="menuitem" data-action="connect" @onclick="() => Choose(ConnectChoice)">Connect to a pin</button>
                </div>
            }
            @if (ActionSpots() is { } spots)
            {
                <div class="part-actions" role="toolbar" aria-label="Selection" @onclick:stopPropagation>
                    @foreach (var (action, label, style) in spots)
                    {
                        <button type="button" class="part-action" data-action="@action" aria-label="@label" title="@label" style="@style" @onclick="() => Act(action)">@ActionGlyph(action)</button>
                    }
                </div>
            }
            @if (problems.Count > 0)
            {
                <ul class="problems" aria-label="Problems">
                    @foreach (var problem in problems)
                    {
                        <li><button type="button" class="@($"problem-item {problem.Severity.ToString().ToLowerInvariant()}")" @onclick="() => SelectPart(problem.Reference)" @onclick:stopPropagation>@problem.Message</button></li>
                    }
                </ul>
            }
            <div class="schematic-zoom" role="group" aria-label="Zoom" @onclick:stopPropagation @ondblclick:stopPropagation>
                <button type="button" data-zoom="out" aria-label="Zoom out" title="Zoom out (-)" disabled="@(view is { Zoom: <= ViewTransform.MinZoom })" @onclick="() => ZoomStep(1 / ZoomStepFactor)">&minus;</button>
                <input class="zoom-level" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" aria-label="Zoom level" value="@($"{(int)Math.Round(Zoom() * 100)}%")"
                       @onchange="ZoomTyped" @onkeydown:stopPropagation @onfocus="() => zoomMenu = false" />
                <button type="button" data-zoom="in" aria-label="Zoom in" title="Zoom in (+)" disabled="@(view is { Zoom: >= ViewTransform.MaxZoom })" @onclick="() => ZoomStep(ZoomStepFactor)">+</button>
                <button type="button" data-zoom="fit" title="Fit the circuit (0)" @onclick="FitView">Fit</button>
                <button type="button" data-zoom="menu" aria-label="Zoom menu" aria-haspopup="menu" aria-expanded="@(zoomMenu ? "true" : "false")" @onclick="() => zoomMenu = !zoomMenu">&#9662;</button>
                @if (zoomMenu)
                {
                    <div class="zoom-menu" role="menu">
                        <button type="button" role="menuitem" data-zoom-item="fit" @onclick="FitView">Fit</button>
                        <button type="button" role="menuitem" data-zoom-item="100" @onclick="() => ZoomLevel(1)">100%</button>
                        <button type="button" role="menuitem" data-zoom-item="selection" title="Fit selection (F)" @onclick="FitSelection">Fit selection</button>
                    </div>
                }
            </div>
        }
    </figure>
    </div>
</section>

@code {
    enum Tool { Wire, Ground }

    const string HintsKey = "ssp.hints";

    static readonly (string Id, string Text)[] FirstRun =
    [
        ("place", "Tap a part in the palette to add it."),
        ("pin", "Tap a pin to see where to go."),
        ("select", "Tap a part to move, flip or delete it."),
    ];

    // The hints done so far. They are kept in localStorage, so a done hint stays gone.
    readonly HashSet<string> dismissed = [];

    sealed record PinView(PinRef Ref, string Node, Point Position);
    // NOTE: One label for each net, on its first pin. It is in the pin layer, so it moves nothing.
    // Ground is 0 V and has no label. A net the last run did not know has none either.
    IEnumerable<(string Node, Point At, string Text)> VoltageLabels() =>
        NodeVoltages is null ? [] : pins.Where(p => p.Node != "0" && NodeVoltages.ContainsKey(p.Node))
            .GroupBy(p => p.Node).Select(g => (g.Key, g.First().Position, Eng.Format(NodeVoltages[g.Key], "V")));

    sealed record JackView(Point At, string Label);

    sealed record PartView(string Reference, Point Min, Point Max);

    // The knob of a pot on the canvas: its position, taper and total resistance.
    sealed record KnobView(string Reference, Point At, double Position, string Taper, double Total);

    List<KnobView> knobs = [];

    // The lever of a switch on the canvas: its middle, its position and its count of throws.
    sealed record SwitchView(string Reference, Point At, int Position, int Throws);

    List<SwitchView> switches = [];

    // NOTE: The hit circle of a lever is this many schematic units, or DotPixels on screen. It is under the pins, so a
    // pin at the end of the lever keeps its tap.
    const double SwitchHit = 14;

    // The knob that the pointer turns: the pointer and the position at the start, the position now, and whether it moved.
    (string Reference, double FromY, double From, double Now, bool Moved)? turning;

    // NOTE: The hit circle of a knob is DotPixels on screen at any zoom, so a finger can turn a knob on a zoomed-out canvas.
    // NOTE: The face of a knob is at least KnobRadius pixels on screen, so it stays legible on a zoomed-out canvas.
    // NOTE: A drag of this many pixels turns a knob from 0% to 100%. A wheel tick turns it 5%, an arrow key 1%.
    const double KnobTravel = 150, KnobRadius = 9, WheelStep = 0.05, KeyStep = 0.01;

    static readonly Regex ViewBox = new("viewBox=\"([^\"]*)\"");

    [Parameter] public string Netlist { get; set; } = "";

    /// <summary>The layout of the netlist. With no layout the editor starts from the auto-placement.</summary>
    [Parameter] public LayoutDoc? Layout { get; set; }

    /// <summary>Gets the netlist and the layout after each place, wire and ground.</summary>
    [Parameter] public EventCallback<SchematicChange> Changed { get; set; }

    /// <summary>The node voltages of the last good run. Each net shows its voltage on the canvas.</summary>
    [Parameter] public IReadOnlyDictionary<string, double>? NodeVoltages { get; set; }

    /// <summary>True while the voltages are from before the last edit.</summary>
    [Parameter] public bool Stale { get; set; }

    /// <summary>Controls of the page, such as Run, Undo and Redo. They sit at the start of the tool row, next to the canvas.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>The clock of the long press. Tests set a fake one.</summary>
    [Parameter] public TimeProvider? Clock { get; set; }

    /// <summary>Gets the nodes of the part or pin under the pointer, and no nodes when the pointer leaves it.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<string>> Pointed { get; set; }

    /// <summary>Where My Blocks are kept. With none it is the browser <c>localStorage</c>.</summary>
    [Parameter] public IKeyValueStore? BlockStorage { get; set; }

    /// <summary>The saved view of the project, as <see cref="ViewTransform.Format"/>. A circuit from outside the editor opens with it, or with a fit if it is null.</summary>
    [Parameter] public string? View { get; set; }

    /// <summary>Gets the view after the user zooms or pans.</summary>
    [Parameter] public EventCallback<string> ViewChanged { get; set; }

    /// <summary>The loads of the editor page. With none the editor loads the netlist itself.</summary>
    [CascadingParameter] public NetlistCache? Loads { get; set; }

    /// <summary>The layout on the canvas: the given layout, or the auto-placement.</summary>
    public LayoutDoc Drawn => layout;

    string? seenNetlist;
    LayoutDoc? seenLayout;
    string netlist = "";
    LayoutDoc layout = new([], []);
    LayoutDoc? given;
    string? shape;
    PartMap? parts;
    bool hasErrors;
    string? svg;
    string viewBox = "";
    List<PinView> pins = [];
    List<JackView> jacks = [];

    // A message for the status line from the last key or tap. The next tap on a pin, a tool or the canvas clears it.
    string? status;
    List<PartView> outlines = [];
    string? selected;
    int? selectedWire;

    // The parts that a group edit takes, when two or more are selected. Then selected is null.
    readonly HashSet<string> group = new(StringComparer.OrdinalIgnoreCase);

    // What Copy or Cut kept. Paste adds it with fresh references.
    Clip? clip;

    // The block list, My Blocks from storage, and the block that the next tap on the empty canvas inserts.
    bool blocksOpen;
    IReadOnlyList<SavedBlock> myBlocks = [];
    (string Name, Clip Clip)? pick;

    // The selection that the name box saves as a block, and the name.
    Clip? saving;
    string? savingName;

    // Whether a one-pointer drag on the empty canvas draws a selection box. Shift and a drag draw one too.
    bool boxTool;

    // The selection box in client pixels, while the pointer draws it.
    // NOTE: It is kept in client pixels, so the moves that come before PanDown has measured the pane are not lost.
    (Point From, Point To)? boxing;

    // NOTE: A drag ends with a click on the part. That click keeps the group.
    bool dragged;

    // NOTE: The state before the last delete, kept for UndoSeconds. Any other edit drops it.
    const int UndoSeconds = 8;
    const double ActionPixels = 44, ActionGap = 8, LabelPixels = 28, FingerPixels = 12;
    (string Name, SchematicChange Before)? undo;
    CancellationTokenSource? undoTimer;
    Tool? tool = Tool.Wire;

    // NOTE: The hit circle of a pin is 24 units across or more, and 44 px or more on screen, the least that a finger can hit.
    const double HitRadius = 12;

    // The active pin, or the open end of a wire. Its + dots show where a move can go. The chosen direction has the picker open.
    Spot? active;
    List<Direction> free = [];
    Direction? chosen;
    List<Point> opens = [];

    // Whether the next tap on a pin joins it to the active pin.
    bool connecting;

    // NOTE: The least that a finger can hit is 44 px, so the hit circle of a dot has a radius of 22 px at any zoom. At a low zoom the circles of two dots overlap.
    const double DotPixels = 22;
    const double VisibleDot = 12;
    const string WireChoice = "wire", GroundChoice = "ground", ConnectChoice = "connect";

    static readonly Dictionary<string, string> Letters = new()
    {
        ["r"] = "resistor", ["c"] = "capacitor", ["q"] = "npn", ["d"] = "diode", ["p"] = "pot", ["b"] = "battery",
        ["s"] = "source", ["i"] = "jack-in", ["o"] = "jack-out", ["l"] = "led", ["n"] = "pnp",
        ["g"] = GroundChoice, ["w"] = WireChoice,
    };

    // NOTE: A drag under this many pixels is a click. A finger drifts more than a mouse, so a touch has the slop of a long press.
    const double DragSlop = 4;

    // A press on a part or the empty canvas. Held, it opens the part actions on a part and does nothing on the canvas.
    LongPress? press;

    ElementReference pane;
    IJSObjectReference? module;

    // The view of the canvas, in pixels of the pane. World is in units of the view box.
    // NOTE: Every pointer position goes through the view, so place, move and wire hit the same grid point at any zoom.
    // NOTE: Null only until the first render has measured the pane. Then the view is a real transform, and only Fit, zoom, wheel, pinch and pan change it.
    const double ZoomStepFactor = 1.25;
    const double FitMargin = 24;

    // NOTE: The zoom control sits in the bottom right corner. Fit keeps the circuit above this band, so the control covers no part.
    const double ZoomBand = 56;
    // NOTE: The problem list floats at the top of the pane, up to 6 rem and a 0.25 rem gap. A dot revealed in the pane stays below it.
    const double ProblemsBand = 100;
    ViewTransform? view;
    ViewTransform? savedView;
    bool viewTouched;
    bool zoomMenu;
    // NOTE: A new active pin brings its + dots into the pane after the next render. At 200 percent the circuit can grow past the pane.
    bool revealActive;
    (double X, double Y, double W, double H) box;

    // The pointers that are down on the empty canvas, by id, in client pixels. One pans, two pan and pinch.
    readonly Dictionary<long, Point> touches = [];
    double[] paneBox = [0, 0, 0, 0];
    bool panMoved;
    Point panFrom;

    // Whether the picker for the chosen direction is open.
    bool menuOpen;

    // A part that the pointer moves: its outline at the start, the pointer at the start, the scale at the start, and the snapped offset.
    PartView? moving;
    Point moveFrom;
    double moveScale = 1;
    Point? ghost;
    Point moveDelta;
    bool moveMoved;

    // NOTE: The editor keeps its own copy, so a parent that does not pass the change back still sees each edit.
    protected override async Task OnInitializedAsync()
    {
        press = new LongPress(Clock ?? TimeProvider.System, () => _ = InvokeAsync(Held));
        await LoadHints();
    }

    protected override void OnParametersSet()
    {
        if (Netlist == seenNetlist && ReferenceEquals(Layout, seenLayout)) return;
        seenNetlist = Netlist;
        seenLayout = Layout;
        // NOTE: The parent passes each edit back. That echo keeps the undo, any other netlist drops it.
        if (Netlist != netlist) ClearUndo();
        // NOTE: The echo of an edit keeps the active pin, so the chain goes on when the parent passes the change back.
        var external = Netlist != netlist;
        var keep = external ? null : active;
        // NOTE: An edit keeps the view. A circuit from outside the editor gets a new fit.
        netlist = Netlist;
        given = Layout;
        Build();
        if (external) (view, savedView) = (null, ViewTransform.Parse(View));
        if (keep is { } again) Activate(again);
    }

    IReadOnlyList<Problem> problems = [];

    void Build()
    {
        status = null;
        selectedWire = null;
        active = null;
        (free, chosen, opens) = ([], null, []);
        (menuOpen, connecting) = (false, false);
        var wasBlank = svg is null;
        svg = null;
        pins = [];
        jacks = [];
        outlines = [];
        knobs = [];
        switches = [];
        var circuit = Loads?.Load(netlist) ?? NetlistLoader.Load(netlist);
        hasErrors = circuit.Diagnostics.Any(d => d.Severity == Severity.Error);
        problems = hasErrors ? [] : Problems.Find(circuit);
        if (hasErrors) return;

        parts = PartMap.Resolve(circuit, SchematicView.Table);
        // NOTE: The placer is slow. With no given layout, a netlist with the same parts and nodes as the last auto-placement
        // (a value edit, a comment) keeps that placement.
        var next = AutoPlacer.Shape(circuit);
        layout = given ?? (next == shape ? layout : AutoPlacer.Place(circuit, circuit.Directives));
        shape = given is null ? next : null;
        if (!circuit.Circuit.OfType<SpiceComponent>().Any()) return;

        svg = SchematicRenderer.ToSvg(circuit, layout, parts);
        if (wasBlank) view = null;
        viewBox = ViewBox.Match(svg).Groups[1].Value;
        var v = viewBox.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(t => double.Parse(t, CultureInfo.InvariantCulture)).ToArray();
        box = (v[0], v[1], v[2], v[3]);
        var placements = layout.Parts.ToDictionary(p => p.Reference, StringComparer.OrdinalIgnoreCase);
        var elements = SchematicRenderer.Elements(circuit, parts);
        // NOTE: A switch S or a pot P is placed as S_1 or P_1. Its outline and pins are those of S or P, not of the resistor S_1 or P_1.
        var levers = elements.Where(e => SchematicEdits.IsSwitch(e.Kind)).ToList();
        var inElement = levers.Concat(elements.Where(e => e.Kind == "pot")).SelectMany(e => e.Members).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var c in circuit.Circuit.OfType<SpiceComponent>().OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
        {
            if (inElement.Contains(c.Name) || !placements.TryGetValue(c.Name, out var placement)) continue;
            var row = parts.Parts.GetValueOrDefault(c.Name);
            var (min, max) = SchematicRenderer.Outline(c, placement, row);
            outlines.Add(new PartView(c.Name, min, max));
            var positions = SchematicRenderer.Pins(c, placement, row);
            pins.AddRange(positions.Select((p, i) => new PinView(new PinRef(c.Name, i), c.Nodes[i], p)));
        }
        var thrown = circuit.Directives.Switches.GroupBy(s => s.Part, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Position, StringComparer.OrdinalIgnoreCase);
        foreach (var e in levers)
        {
            if (!(placements.TryGetValue(e.Reference, out var placement) || placements.TryGetValue(e.Members[0], out placement))) continue;
            var (min, max) = SchematicRenderer.Outline(e, placement);
            outlines.Add(new PartView(e.Reference, min, max));
            pins.AddRange(SchematicRenderer.Pins(e, placement).Select((p, i) => new PinView(new PinRef(e.Reference, i), p.Net, p.At)));
            var (sx, sy) = SchematicRenderer.Place(placement, 30, 0);
            switches.Add(new SwitchView(e.Reference, new Point(sx, sy), thrown.GetValueOrDefault(e.Reference), SchematicEdits.Throws(e.Kind!)));
        }
        var tuned = circuit.Directives.Knobs.GroupBy(k => k.Part, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        foreach (var pot in elements.Where(e => e.Kind == "pot"))
        {
            if (!(placements.TryGetValue(pot.Reference, out var placement) || placements.TryGetValue(pot.Members[0], out placement))) continue;
            var (min, max) = SchematicRenderer.PotOutline(placement);
            outlines.Add(new PartView(pot.Reference, min, max));
            pins.AddRange(SchematicRenderer.PotPins(placement).Select((p, i) => new PinView(new PinRef(pot.Reference, i), pot.Nodes[i], p)));
            if (!tuned.TryGetValue(pot.Reference, out var knob)) continue;
            // NOTE: The knob sits over the right half of the track, beside the wiper lead.
            var (kx, ky) = SchematicRenderer.Place(placement, 48, -20);
            var total = circuit.Circuit.OfType<SpiceSharp.Components.Resistor>().Where(r => pot.Members.Contains(r.Name, StringComparer.OrdinalIgnoreCase)).Sum(r => r.Parameters.Resistance.Value);
            knobs.Add(new KnobView(pot.Reference, new Point(kx, ky), knob.Position, knob.Taper, total));
        }
        // NOTE: A jack is a marker on a node. The symbol sits at the first pin on that node.
        foreach (var (node, label) in new[] { (circuit.Directives.Input, "IN"), (circuit.Directives.Output, "OUT") })
        {
            if (node is not null && pins.FirstOrDefault(p => p.Node == node) is { } jackPin) jacks.Add(new JackView(jackPin.Position, label));
        }
        opens = SchematicEdits.OpenEnds(layout, pins.Select(p => p.Position)).ToList();
        if (!outlines.Any(p => p.Reference == selected)) selected = null;
        group.RemoveWhere(r => !outlines.Any(o => o.Reference == r));
    }

    public async ValueTask DisposeAsync()
    {
        undoTimer?.Cancel();
        press?.Dispose();
        if (module is not null) await module.DisposeAsync();
    }

    // NOTE: The module loads on the first pointer use, so a page with no pointer never loads it.
    async Task<IJSObjectReference> Module() =>
        module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/schematic-canvas.js");

    // NOTE: A switch in the palette has its lever at its first position.
    static string SymbolOf(string kind) => Symbols.Icon(kind);

    // The pane box in client pixels: left, top, width, height.
    // NOTE: A module that gives no box, as in a test, leaves the last box.
    async Task<double[]> PaneBox()
    {
        var measured = await (await Module()).InvokeAsync<double[]>("paneBox", pane);
        if (measured is { Length: >= 4 }) paneBox = measured;
        return paneBox;
    }

    async Task<ViewTransform> Current()
    {
        if (view is not null) return view;
        var b = await PaneBox();
        if (savedView is { } kept)
        {
            savedView = null;
            return view = kept;
        }
        return view = b is { Length: >= 4 } && b[2] > 0
            ? ViewTransform.Fit(box.X, box.Y, box.W, box.H, b[2], Math.Max(b[3] - ZoomBand, b[3] / 2), FitMargin)
            : ViewTransform.Identity;
    }

    // NOTE: The first render draws the stage hidden. This measures the pane and sets the view, so the canvas never shows a view that it then replaces.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        still = false;
        if (revealActive)
        {
            revealActive = false;
            if (active is { } spot && view is not null && free.Count > 0)
            {
                var dots = free.Select(d => SchematicEdits.Toward(spot.At, d)).Append(spot.At).ToList();
                var before = view;
                await Reveal(new Point(dots.Min(q => q.X), dots.Min(q => q.Y)), new Point(dots.Max(q => q.X), dots.Max(q => q.Y)), problems.Count > 0 ? ProblemsBand : 0);
                if (view != before)
                {
                    viewTouched = true;
                    StateHasChanged();
                }
            }
        }
        if (viewTouched && view is not null)
        {
            viewTouched = false;
            await ViewChanged.InvokeAsync(view.Format());
        }
        if (svg is null || view is not null) return;
        try { await Current(); }
        catch (Exception) { return; }
        StateHasChanged();
    }

    // NOTE: The least that brings a world box in view. The zoom does not change.
    async Task Reveal(Point min, Point max, double top = 0)
    {
        if (view is null || svg is null) return;
        double[] b;
        try { b = await PaneBox(); }
        catch (JSException) { return; }
        if (b is not { Length: >= 4 } || b[2] <= 0) return;
        view = view.Reveal(min, max, b[2], b[3], FitMargin, top);
    }

    // The world point of a client position, and whether the position is on the canvas.
    async Task<(Point At, bool Inside)> ToCanvas(double x, double y)
    {
        var b = await PaneBox();
        var inside = x >= b[0] && x <= b[0] + b[2] && y >= b[1] && y <= b[1] + b[3];
        var current = svg is null ? ViewTransform.Identity : await Current();
        return (current.ScreenToWorld(new Point(x - b[0], y - b[1])), inside);
    }

    string StageStyle() => view is not { } v ? "" : FormattableString.Invariant(
        $"--w: {box.W}px; --h: {box.H}px; --x: {v.X + box.X * v.Zoom}px; --y: {v.Y + box.Y * v.Zoom}px; --z: {v.Zoom}");

    void SetView(ViewTransform next)
    {
        view = next;
        viewTouched = true;
    }

    async Task FitView()
    {
        if (svg is null) return;
        view = null;
        savedView = null;
        zoomMenu = false;
        await Current();
        viewTouched = true;
    }

    // NOTE: The selected parts fill the pane, as far as 400 percent. With no selection it is a fit of the whole circuit.
    async Task FitSelection()
    {
        zoomMenu = false;
        var chosen = outlines.Where(o => Selection().Contains(o.Reference)).ToList();
        if (chosen.Count == 0)
        {
            await FitView();
            return;
        }
        var b = await PaneBox();
        if (b[2] <= 0) return;
        var (min, max) = (new Point(chosen.Min(o => o.Min.X), chosen.Min(o => o.Min.Y)), new Point(chosen.Max(o => o.Max.X), chosen.Max(o => o.Max.Y)));
        SetView(ViewTransform.Fit(min.X, min.Y, max.X - min.X, max.Y - min.Y, b[2], Math.Max(b[3] - ZoomBand, b[3] / 2), FitMargin, maxZoom: 4));
    }

    async Task ZoomStep(double factor)
    {
        var b = await PaneBox();
        SetView((await Current()).ZoomAbout(new Point(b[2] / 2, b[3] / 2), factor));
    }

    // NOTE: The zoom field takes 150 or 150%. Text that is not a number puts the old level back.
    async Task ZoomTyped(ChangeEventArgs e)
    {
        var text = e.Value?.ToString()?.Trim().TrimEnd('%').Trim();
        if (!double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var percent) || !double.IsFinite(percent) || percent <= 0) return;
        await ZoomLevel(percent / 100);
    }

    async Task ZoomLevel(double zoom)
    {
        zoomMenu = false;
        var b = await PaneBox();
        SetView((await Current()).ZoomTo(new Point(b[2] / 2, b[3] / 2), zoom));
    }

    // NOTE: A double click or double tap on the empty canvas zooms in at that point. A part or a wire under it keeps its own double click.
    async Task CanvasDoubleClick(MouseEventArgs e)
    {
        if (svg is null || pick is not null) return;
        var b = await PaneBox();
        var at = new Point(e.ClientX - b[0], e.ClientY - b[1]);
        var current = await Current();
        var world = current.ScreenToWorld(at);
        if (outlines.Any(o => o.Min.X <= world.X && world.X <= o.Max.X && o.Min.Y <= world.Y && world.Y <= o.Max.Y)) return;
        SetView(current.ZoomAbout(at, ZoomStepFactor));
    }

    // NOTE: A pinch on a trackpad is a wheel with Ctrl held, so it follows the fingers with a finer step. A tick of a mouse wheel is 1.15x.
    async Task Wheel(WheelEventArgs e)
    {
        if (svg is null) return;
        var b = await PaneBox();
        SetView((await Current()).ZoomAbout(new Point(e.ClientX - b[0], e.ClientY - b[1]), ViewTransform.WheelFactor(e.DeltaY, e.DeltaMode == 1 ? 1 : 0, e.CtrlKey)));
    }

    async Task PanDown(PointerEventArgs e)
    {
        if (e.Button > 0 || moving is not null) return;
        // NOTE: The Select tool or Shift turns a one-pointer drag into a box. A second finger still pans and pinches.
        if ((boxTool || e.ShiftKey) && touches.Count == 0)
        {
            var at = new Point(e.ClientX, e.ClientY);
            (boxing, panFrom, panMoved) = ((at, at), at, false);
            await PaneBox();
            await Current();
            return;
        }
        press?.Down(e.PointerId, e.ClientX, e.ClientY);
        if (touches.Count == 0)
        {
            panMoved = false;
            panFrom = new Point(e.ClientX, e.ClientY);
        }
        touches[e.PointerId] = new Point(e.ClientX, e.ClientY);
        await PaneBox();
        await Current();
    }

    void PanMove(PointerEventArgs e)
    {
        if (boxing is { } b)
        {
            var to = new Point(e.ClientX, e.ClientY);
            var slop = Slop(e);
            if (!panMoved && Math.Abs(e.ClientX - panFrom.X) <= slop && Math.Abs(e.ClientY - panFrom.Y) <= slop) return;
            (boxing, panMoved) = ((b.From, to), true);
            return;
        }
        // NOTE: Until PanDown has made the view, the moves are lost.
        // NOTE: A move with no press, or the move of a part drag that bubbles from PartMove, changes nothing here.
        if (view is null || !touches.TryGetValue(e.PointerId, out var last) || moving is not null)
        {
            still = true;
            return;
        }
        press?.Move(e.PointerId, e.ClientX, e.ClientY);
        var now = new Point(e.ClientX, e.ClientY);
        var others = touches.Where(t => t.Key != e.PointerId).Select(t => t.Value).ToList();
        if (others.Count == 1)
        {
            Point Pane(Point p) => new(p.X - paneBox[0], p.Y - paneBox[1]);
            SetView(view!.Pinch(Pane(last), Pane(now), Pane(others[0])));
            panMoved = true;
        }
        else if (others.Count == 0)
        {
            // NOTE: A drag under the slop is a click, so the canvas does not move for it.
            var slop = Slop(e);
            if (!panMoved && Math.Abs(now.X - panFrom.X) <= slop && Math.Abs(now.Y - panFrom.Y) <= slop) return;
            panMoved = true;
            SetView(view!.Pan(now.X - last.X, now.Y - last.Y));
        }
        touches[e.PointerId] = now;
    }

    void PanUp(PointerEventArgs e)
    {
        if (boxing is { } b)
        {
            boxing = null;
            // NOTE: A tap with the Select tool is a tap on the canvas. It clears the selection.
            if (!panMoved) return;
            var (from, to) = (World(b.From), World(b.To));
            var (min, max) = (new Point(Math.Min(from.X, to.X), Math.Min(from.Y, to.Y)), new Point(Math.Max(from.X, to.X), Math.Max(from.Y, to.Y)));
            var inside = outlines.Where(o => o.Min.X <= max.X && o.Max.X >= min.X && o.Min.Y <= max.Y && o.Max.Y >= min.Y).Select(o => o.Reference);
            SelectMany(e.ShiftKey ? Selection().Concat(inside) : inside);
            return;
        }
        press?.Up(e.PointerId);
        touches.Remove(e.PointerId);
    }

    // The schematic point of a client position, from the last pane box and view.
    Point World(Point client) => (view ?? ViewTransform.Identity).ScreenToWorld(new Point(client.X - paneBox[0], client.Y - paneBox[1]));

    static double Slop(PointerEventArgs e) => e.PointerType == "touch" ? LongPress.Slop : DragSlop;

    // NOTE: A long press on a part keeps it selected with its actions open and drops the drag, so the drift of the finger moves nothing.
    // On the empty canvas it does nothing, and the tap that ends it clears nothing.
    void Held()
    {
        // NOTE: A mouse drag starts at 4 px, under the slop of a long press. A drag that has started stays a drag.
        if (moving is not { } part || moveMoved) return;
        (moving, ghost) = (null, null);
        (selected, selectedWire) = (part.Reference, null);
        StateHasChanged();
    }

    // NOTE: The part lands at the centre of the visible canvas. With no pane box, as in a test, it lands in the next column.
    async Task PaletteAdd(string kind)
    {
        if (hasErrors) return;
        _ = Done("place");
        if (kind is "jack-in" or "jack-out")
        {
            if (active is { } pin && parts is not null)
            {
                await Apply(SchematicEdits.PlaceJack(netlist, layout, parts, kind, pin));
                Activate(pin);
            }
            else status = $"Tap a pin first, then {Label(kind)}.";
            return;
        }
        double[]? b = null;
        try { b = await PaneBox(); }
        catch (JSException) { }
        if (b is not { Length: >= 4 })
        {
            await Place(kind);
            return;
        }
        var (at, _) = await ToCanvas(b[0] + b[2] / 2, b[1] + b[3] / 2);
        await PlaceAt(kind, at);
    }

    // NOTE: A tap on the empty canvas clears the selected part, the selected wire, the active pin and the picker.
    async Task CanvasClick(MouseEventArgs e)
    {
        if (press?.Fired == true) return;
        if (panMoved)
        {
            panMoved = false;
            return;
        }
        if (pick is { } p)
        {
            await Insert(p.Name, p.Clip, new Point(e.ClientX, e.ClientY));
            return;
        }
        (selected, selectedWire) = (null, null);
        group.Clear();
        ClearActive();
    }

    // NOTE: New asks for no confirmation. Undo in the status line restores the old circuit.
    async Task NewCircuit()
    {
        var before = new SchematicChange(netlist, layout);
        selected = null;
        group.Clear();
        await Apply(new SchematicChange("", new LayoutDoc([], [])));
        undo = ("circuit", before);
        undoTimer = new CancellationTokenSource();
        _ = ExpireUndo(undoTimer.Token);
    }

    void ClearActive()
    {
        status = null;
        active = null;
        (free, chosen) = ([], null);
        (menuOpen, connecting) = (false, false);
    }

    void Activate(Spot spot)
    {
        if (panMoved || parts is null) return;
        _ = Done("pin");
        (selected, selectedWire) = (null, null);
        group.Clear();
        ClearActive();
        active = spot;
        free = SchematicEdits.Directions(netlist, layout, parts, spot).ToList();
        revealActive = true;
    }

    void OpenMenu(Direction direction)
    {
        if (panMoved) return;
        (chosen, menuOpen) = (direction, true);
    }

    async Task TapDot(Direction direction)
    {
        OpenMenu(direction);
        await Focus();
    }

    // NOTE: A tap on an SVG pin or a menu button leaves the focus off the canvas, so the keys would do nothing.
    async Task Focus()
    {
        try { await pane.FocusAsync(); }
        catch (InvalidOperationException) { }
    }

    // The dot radius in schematic units: 22 px at the zoom of the view.
    double DotRadius() => DotPixels / Zoom();

    // The hit radius of a pin in schematic units: 12 units, or 22 px at a low zoom.
    double PinHit() => Math.Max(HitRadius, DotPixels / Zoom());

    double Zoom() => view?.Zoom ?? 1;

    static string Name(Spot spot) => spot.Pin is { } pin ? $"{pin.Reference} pin {pin.Pin + 1}" : "open end";

    string PinClass(PinView pin) =>
        (pin.Ref == active?.Pin ? "pin active" : connecting ? "pin target" : "pin")
        + (problems.Any(p => p.Pin is { } i && p.Reference == pin.Ref.Reference && i == pin.Ref.Pin) ? " problem" : "");

    // NOTE: A problem pin keeps a 10 px ring on screen at any zoom.
    double PinRadius(PinView pin, bool target) =>
        PinClass(pin).EndsWith("problem", StringComparison.Ordinal) ? Math.Max(target ? 7 : 5, 10 / Zoom()) : target ? 7 : 5;

    string PartClass(string reference) =>
        (reference == selected || group.Contains(reference) ? "part selected" : "part")
        + (problems.Any(p => p.Pin is null && p.Reference == reference) ? " problem" : "");

    // NOTE: The picker opens under its dot, or over it near the foot of the pane.
    string MenuStyle(Spot origin, Direction direction)
    {
        if (view is not { } v || paneBox[2] <= 0) return "";
        const double Width = 260, Height = 250, Gap = 8;
        var dot = v.WorldToScreen(SchematicEdits.Toward(origin.At, direction));
        var left = Math.Clamp(dot.X - Width / 2, Gap, Math.Max(Gap, paneBox[2] - Width - Gap));
        var top = dot.Y + DotPixels + Gap + Height <= paneBox[3] ? dot.Y + DotPixels + Gap : Math.Max(Gap, dot.Y - DotPixels - Gap - Height);
        return FormattableString.Invariant($"left: {left:0.#}px; top: {top:0.#}px; right: auto; max-width: {Width}px");
    }

    // A kind, Wire or Ground from the picker or a key goes in the chosen direction from the active pin. Connect lights the other pins.
    async Task Choose(string choice)
    {
        await Focus();
        if (active is not { } from || parts is null) return;
        if (choice == GroundChoice)
        {
            await Apply(SchematicEdits.Ground(netlist, layout, parts, from));
            Activate(from);
            status = $"Grounded {Name(from)}.";
            return;
        }
        if (choice == ConnectChoice)
        {
            (connecting, menuOpen) = (true, false);
            return;
        }
        if (chosen is not { } direction) return;
        if (choice is "jack-in" or "jack-out")
        {
            await Apply(SchematicEdits.PlaceJack(netlist, layout, parts, choice, from));
            Activate(from);
            return;
        }
        if (choice == WireChoice)
        {
            var (wired, open) = SchematicEdits.ExtendWire(netlist, layout, parts, from, direction);
            await Apply(wired);
            Activate(open);
            await Reveal(open.At, open.At);
            return;
        }
        var (change, far) = SchematicEdits.PlaceNext(netlist, layout, parts, choice, from, direction);
        await Apply(change);
        Activate(far);
        await Reveal(far.At, far.At);
    }

    async Task PlaceAt(string kind, Point at)
    {
        var change = SchematicEdits.PlaceAt(netlist, layout, kind, at);
        await Apply(change);
        // NOTE: Place puts the new part last in the layout.
        selected = change.Layout.Parts[^1].Reference;
        if (outlines.FirstOrDefault(o => o.Reference == selected) is { } outline) await Reveal(outline.Min, outline.Max);
    }

    async Task PartDown(string reference, PointerEventArgs e)
    {
        if (e.Button > 0) return;
        // NOTE: A press on a part of the group drags the group. A press with Shift, Ctrl or Cmd waits for the click to add the part.
        if (!group.Contains(reference) && !(e.ShiftKey || e.CtrlKey || e.MetaKey || boxTool)) SelectPart(reference);
        dragged = false;
        press?.Down(e.PointerId, e.ClientX, e.ClientY);
        moving = outlines.Single(p => p.Reference == reference);
        moveFrom = new Point(e.ClientX, e.ClientY);
        moveScale = 1 / (await Current()).Zoom;
        moveDelta = new Point(0, 0);
        moveMoved = false;
    }

    // PERF: A pointer move that changes nothing on the screen does not render the editor: on a large circuit one render
    // takes about a frame (#179). OnAfterRenderAsync clears it, so a render that was already queued does not keep it.
    bool still;

    protected override bool ShouldRender()
    {
        var render = !still;
        still = false;
        return render;
    }

    void PartMove(PointerEventArgs e)
    {
        still = true;
        if (moving is null) return;
        press?.Move(e.PointerId, e.ClientX, e.ClientY);
        var (px, py) = (e.ClientX - moveFrom.X, e.ClientY - moveFrom.Y);
        moveMoved |= Math.Abs(px) > Slop(e) || Math.Abs(py) > Slop(e);
        if (!moveMoved) return;
        moveDelta = new Point(px * moveScale, py * moveScale);
        var shown = ghost;
        // NOTE: The ghost shows where the part lands. It is the offset of the snapped position, not of the pointer.
        var at = layout.Parts.FirstOrDefault(p => string.Equals(p.Reference, moving.Reference, StringComparison.OrdinalIgnoreCase) || string.Equals(p.Reference, moving.Reference + "_1", StringComparison.OrdinalIgnoreCase));
        ghost = at is null ? moveDelta : new Point(SchematicEdits.Snap(at.X + moveDelta.X) - at.X, SchematicEdits.Snap(at.Y + moveDelta.Y) - at.Y);
        still = ghost == shown;
    }

    async Task PartUp(PointerEventArgs e)
    {
        press?.Up(e.PointerId);
        if (moving is not { } part) return;
        var moved = moveMoved;
        (moving, ghost) = (null, null);
        dragged = moved;
        if (!moved) return;
        // NOTE: The whole group moves in one edit, so one Undo takes it back.
        if (group.Contains(part.Reference)) await Apply(SchematicEdits.DragMany(netlist, layout, parts!, group.ToList(), moveDelta.X, moveDelta.Y));
        else await Apply(SchematicEdits.Drag(netlist, layout, parts!, part.Reference, moveDelta.X, moveDelta.Y));
    }

    async Task Place(string kind)
    {
        _ = Done("place");
        var change = SchematicEdits.Place(netlist, layout, kind);
        await Apply(change);
        // NOTE: Place puts the new part last in the layout.
        selected = change.Layout.Parts[^1].Reference;
        if (outlines.FirstOrDefault(o => o.Reference == selected) is { } outline) await Reveal(outline.Min, outline.Max);
    }

    string Hint() =>
        connecting ? "Tap the pin to join. Esc cancels."
        : pick is { } p ? $"Tap an empty spot, a wire or a junction to insert {p.Name}. Esc cancels."
        : pointing is not null && status is null && !menuOpen ? pointing
        : status is not null ? status
        : menuOpen ? "Pick a part, Wire, Ground or Connect."
        : active is { } a ? $"{Name(a)}: tap a +, or press an arrow, then r c q d p b w. G is ground."
        : selectedWire is not null ? "Wire selected: Delete remove"
        : group.Count > 0 ? $"{group.Count} parts selected: drag to move, Ctrl+C copy, Ctrl+X cut, Delete remove"
        : boxTool ? "Drag a box around parts, or tap parts to select them."
        : selected is { } s ? $"{s} selected: R rotate, H/V flip, arrows move, Delete remove"
        : tool == Tool.Ground ? "Ground: click a pin"
        : tool == Tool.Wire ? "Tap a pin to see where to go."
        : "Choose a tool, or place a part.";

    void Select(Tool next)
    {
        tool = tool == next ? null : next;
        ClearActive();
        selected = null;
        group.Clear();
        selectedWire = null;
    }

    async Task Click(PinRef pin, MouseEventArgs e)
    {
        if (panMoved) return;
        await Focus();
        // NOTE: A pin covers much of a small part on a phone. With the Select tool, or Shift, Ctrl or Cmd, a tap on a pin takes its part.
        if (boxTool || e.ShiftKey || e.CtrlKey || e.MetaKey)
        {
            Toggle(pin.Reference);
            return;
        }
        if (tool == Tool.Ground)
        {
            await Apply(SchematicEdits.Ground(netlist, layout, parts!, pin));
        }
        else if (connecting && active is { } from)
        {
            if (from.Pin != pin) await Apply(SchematicEdits.Wire(netlist, layout, parts!, from, pin));
        }
        else if (active?.Pin == pin)
        {
            ClearActive();
        }
        else
        {
            Activate(new Spot(pins.First(p => p.Ref == pin).Position, pin));
        }
    }

    // NOTE: Escape clears the selection, so that Tab can move the focus out of the schematic again.
    async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClearActive();
            (pick, blocksOpen) = (null, false);
        }
        switch (e.Key)
        {
            case "+" or "=":
                await ZoomStep(ZoomStepFactor);
                return;
            case "-" or "_":
                await ZoomStep(1 / ZoomStepFactor);
                return;
            case "0":
                await FitView();
                return;
            // NOTE: F fits the selection when two or more parts are selected. With one part selected F still flips it (H does too).
            case "f" or "F" when group.Count > 0 && !e.CtrlKey && !e.MetaKey && !e.AltKey:
                await FitSelection();
                return;
        }
        if ((e.CtrlKey || e.MetaKey) && !e.AltKey && !e.ShiftKey && e.Key.ToLowerInvariant() is "a" or "c" or "x" or "v")
        {
            switch (e.Key.ToLowerInvariant())
            {
                case "a": SelectMany(outlines.Select(o => o.Reference)); break;
                case "c": CopySelection(); break;
                case "x": await CutSelection(); break;
                default: await PasteClip(); break;
            }
            return;
        }
        if (active is not null && await ActiveKey(e)) return;
        if (e.Key == "Escape")
        {
            selectedWire = null;
            group.Clear();
        }
        if (e.Key is "Delete" or "Backspace" or "x" or "X" && (selected is not null || selectedWire is not null || group.Count > 0))
        {
            await DeleteSelected();
            return;
        }
        if (selected is not { } part) return;
        const int Step = Symbols.Grid;
        SchematicChange? change = e.Key switch
        {
            "r" or "R" => SchematicEdits.Rotate(netlist, layout, part),
            "h" or "H" or "f" or "F" => SchematicEdits.Flip(netlist, layout, part, leftToRight: true),
            "v" or "V" => SchematicEdits.Flip(netlist, layout, part, leftToRight: false),
            "ArrowLeft" => SchematicEdits.Move(netlist, layout, part, -Step, 0),
            "ArrowRight" => SchematicEdits.Move(netlist, layout, part, Step, 0),
            "ArrowUp" => SchematicEdits.Move(netlist, layout, part, 0, -Step),
            "ArrowDown" => SchematicEdits.Move(netlist, layout, part, 0, Step),
            "d" or "D" => SchematicEdits.Duplicate(netlist, layout, part),
            _ => null,
        };
        if (e.Key == "Escape") selected = null;
        if (change is null) return;

        await Apply(change);
        // NOTE: Duplicate puts the copy last in the layout.
        if (e.Key is "d" or "D") selected = change.Layout.Parts[^1].Reference;
    }

    // NOTE: With an active pin an arrow picks a direction, a letter picks what goes there, and Tab moves the pin. Ground needs no direction.
    async Task<bool> ActiveKey(KeyboardEventArgs e)
    {
        Direction? arrow = e.Key switch
        {
            "ArrowUp" => Direction.Up,
            "ArrowDown" => Direction.Down,
            "ArrowLeft" => Direction.Left,
            "ArrowRight" => Direction.Right,
            _ => null,
        };
        if (arrow is { } d)
        {
            status = null;
            if (connecting) return true;
            if (free.Contains(d)) OpenMenu(d);
            else status = Blocked(d);
            return true;
        }
        if (e.Key == "Tab")
        {
            Cycle(e.ShiftKey ? -1 : 1);
            return true;
        }
        if (e.CtrlKey || e.MetaKey || e.AltKey || !Letters.TryGetValue(e.Key.ToLowerInvariant(), out var choice)) return false;
        if (connecting) return true;
        if (choice != GroundChoice && chosen is null)
        {
            status = "Pick a direction first, then a letter.";
            return true;
        }
        status = null;
        await Choose(choice);
        return true;
    }

    string Blocked(Direction d)
    {
        var names = free.Select(f => f.ToString().ToLowerInvariant()).ToList();
        var list = names.Count switch { 0 => "", 1 => names[0], _ => string.Join(", ", names[..^1]) + " or " + names[^1] };
        return $"{d} is blocked here." + (list.Length > 0 ? $" Try {list}." : "");
    }

    // Moves the active pin to the next pin or open end, in the order of the netlist.
    void Cycle(int by)
    {
        var all = pins.Select(p => new Spot(p.Position, p.Ref)).Concat(opens.Select(o => new Spot(o))).ToList();
        if (all.Count == 0 || active is not { } now) return;
        var at = all.IndexOf(now);
        Activate(all[((at < 0 ? 0 : at + by) % all.Count + all.Count) % all.Count]);
    }

    static string WirePoints(Ssp.Core.Layout.WireRoute wire) => string.Join(' ', wire.Points.Select(p => $"{N(p.X)},{N(p.Y)}"));

    void SelectPart(string reference)
    {
        _ = Done("select");
        ClearActive();
        group.Clear();
        (selected, selectedWire) = (reference, null);
    }

    // NOTE: Shift, Ctrl or Cmd, or the Select tool, adds the part to the selection or takes it out.
    void ClickPart(string reference, MouseEventArgs e)
    {
        if (dragged)
        {
            dragged = false;
            return;
        }
        if (!(e.ShiftKey || e.CtrlKey || e.MetaKey || boxTool))
        {
            SelectPart(reference);
            return;
        }
        Toggle(reference);
    }

    // Adds a part to the selection, or takes it out.
    void Toggle(string reference)
    {
        var now = Selection().ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!now.Remove(reference)) now.Add(reference);
        SelectMany(now);
    }

    // The selected parts: the group, or the one selected part.
    IReadOnlyCollection<string> Selection() => group.Count > 0 ? group : selected is { } s ? [s] : [];

    // Selects some parts. Two or more make a group. One is the selected part.
    void SelectMany(IEnumerable<string> references)
    {
        ClearActive();
        var all = references.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        group.Clear();
        (selected, selectedWire) = (null, null);
        if (all.Count == 1) selected = all[0];
        else group.UnionWith(all);
    }

    void ToggleBox()
    {
        boxTool = !boxTool;
        ClearActive();
    }

    // The outlines that a drag moves: the group, or the one part.
    IEnumerable<PartView> Moving() =>
        moving is not { } m ? [] : group.Contains(m.Reference) ? outlines.Where(o => group.Contains(o.Reference)) : [m];

    void CopySelection()
    {
        if (parts is null || Selection() is not { Count: > 0 } chosen)
        {
            status = "Select a part first, then copy.";
            return;
        }
        clip = SchematicEdits.Copy(netlist, layout, parts, chosen);
        status = $"Copied {Count(clip.Parts.Count)}.";
    }

    async Task CutSelection()
    {
        if (parts is null || Selection() is not { Count: > 0 } chosen)
        {
            status = "Select a part first, then cut.";
            return;
        }
        var (change, cut) = SchematicEdits.Cut(netlist, layout, parts, chosen.ToList());
        clip = cut;
        SelectMany([]);
        await Apply(change);
        status = $"Cut {Count(cut.Parts.Count)}.";
    }

    // NOTE: The paste is the new selection, so a drag moves it where it goes.
    async Task PasteClip()
    {
        if (clip is null || hasErrors)
        {
            status = "Copy a part first, then paste.";
            return;
        }
        var (change, fresh) = SchematicEdits.Paste(netlist, layout, clip);
        await Apply(change);
        SelectMany(outlines.Where(o => fresh.Contains(o.Reference, StringComparer.OrdinalIgnoreCase) || fresh.Any(f => string.Equals(o.Reference, f + "_1", StringComparison.OrdinalIgnoreCase))).Select(o => o.Reference));
        status = $"Pasted {string.Join(", ", fresh)}.";
        var shown = outlines.Where(o => fresh.Contains(o.Reference, StringComparer.OrdinalIgnoreCase)).ToList();
        if (shown.Count > 0) await Reveal(new Point(shown.Min(o => o.Min.X), shown.Min(o => o.Min.Y)), new Point(shown.Max(o => o.Max.X), shown.Max(o => o.Max.Y)));
    }

    static string Count(int parts) => parts == 1 ? "1 part" : $"{parts} parts";

    BlockStore Blocks() => new(BlockStorage ?? new LocalStorage(Js), Clock);

    async Task ToggleBlocks()
    {
        blocksOpen = !blocksOpen;
        if (!blocksOpen) return;
        try { myBlocks = await Blocks().List(); }
        catch (JSException) { myBlocks = []; }
    }

    // NOTE: A pick arms the block. The next tap on the empty canvas inserts it once.
    void Pick(string name, string blockNetlist, string? blockLayout)
    {
        Clip block;
        try { block = SchematicEdits.Block(blockNetlist, blockLayout is null ? null : LayoutDoc.Parse(blockLayout)); }
        catch (Exception e) when (e is InvalidDataException or InvalidOperationException or ArgumentException)
        {
            status = $"{name} does not read: {e.Message}";
            return;
        }
        blocksOpen = false;
        ClearActive();
        pick = (name, block);
    }

    // NOTE: The insert is one edit, so one undo takes it back. The block is the new selection, so a drag moves it.
    // A tap on a wire or a junction joins the block there (#265). A drop that would short two nets changes nothing.
    async Task Insert(string name, Clip block, Point client, int? wire = null)
    {
        pick = null;
        // NOTE: With no errors the part map is there.
        if (hasErrors || parts is null) return;
        double[]? b = null;
        try { b = await PaneBox(); }
        catch (JSException) { }
        var at = b is { Length: >= 4 } && b[2] > 0 ? (await ToCanvas(client.X, client.Y)).At : World(client);
        var drop = SchematicEdits.Drop(netlist, layout, parts, block, at, wire);
        if (drop.Refused is { } why)
        {
            status = $"{name} is not inserted: {why}";
            return;
        }
        await Apply(drop.Change);
        var fresh = drop.References;
        SelectMany(outlines.Where(o => fresh.Contains(o.Reference, StringComparer.OrdinalIgnoreCase)).Select(o => o.Reference));
        status = $"Inserted {name}: {string.Join(", ", fresh)}. {drop.Message}".TrimEnd();
    }

    async Task WireClick(int index, MouseEventArgs e)
    {
        if (pick is { } p && !panMoved)
        {
            await Insert(p.Name, p.Clip, new Point(e.ClientX, e.ClientY), index);
            return;
        }
        SelectWire(index);
    }

    void StartSave()
    {
        if (parts is null || Selection() is not { Count: > 0 } chosen) return;
        saving = SchematicEdits.Copy(netlist, layout, parts, chosen);
        savingName = $"My block {myBlocks.Count + 1}";
    }

    async Task SaveBlock()
    {
        if (saving is not { } block) return;
        var name = string.IsNullOrWhiteSpace(savingName) ? "My block" : savingName.Trim();
        var alone = SchematicEdits.Alone(block);
        saving = null;
        try
        {
            await Blocks().Save(name, alone.Netlist, LayoutDoc.Format(alone.Layout));
            myBlocks = await Blocks().List();
            status = $"Saved {name} in My Blocks.";
        }
        catch (JSException e)
        {
            status = $"{name} is not saved: {e.Message}";
        }
    }

    void SelectWire(int index)
    {
        if (panMoved) return;
        ClearActive();
        group.Clear();
        (selected, selectedWire) = (null, index);
    }

    void ClearUndo()
    {
        undoTimer?.Cancel();
        undo = null;
    }

    async Task DeleteSelected()
    {
        var before = new SchematicChange(netlist, layout);
        SchematicChange change;
        string name;
        if (selectedWire is { } w && parts is not null)
        {
            (name, change) = ("wire", SchematicEdits.DeleteWire(netlist, layout, parts, w));
        }
        else if (selected is { } part)
        {
            (name, change) = (part, SchematicEdits.Delete(netlist, layout, part));
        }
        else if (group.Count > 0 && parts is not null)
        {
            (name, change) = (Count(group.Count), SchematicEdits.Cut(netlist, layout, parts, group.ToList()).Change);
        }
        else return;

        selected = null;
        group.Clear();
        await Apply(change);
        undo = (name, before);
        undoTimer = new CancellationTokenSource();
        _ = ExpireUndo(undoTimer.Token);
    }

    async Task ExpireUndo(CancellationToken token)
    {
        try { await Task.Delay(TimeSpan.FromSeconds(UndoSeconds), token); }
        catch (TaskCanceledException) { return; }
        await InvokeAsync(() =>
        {
            undo = null;
            StateHasChanged();
        });
    }

    async Task Undo()
    {
        if (undo is not { } last) return;
        await Apply(last.Before);
    }

    async Task RotateSelected()
    {
        if (selected is { } part) await Apply(SchematicEdits.Rotate(netlist, layout, part));
    }

    async Task FlipSelected()
    {
        if (selected is { } part) await Apply(SchematicEdits.Flip(netlist, layout, part, leftToRight: true));
    }

    async Task DuplicateSelected()
    {
        if (selected is not { } part) return;
        var change = SchematicEdits.Duplicate(netlist, layout, part);
        await Apply(change);
        selected = change.Layout.Parts[^1].Reference;
        if (outlines.FirstOrDefault(o => o.Reference == selected) is { } outline) await Reveal(outline.Min, outline.Max);
    }

    static string ActionGlyph(string action) => action switch
    {
        "delete" => "\u2715",
        "rotate" => "\u21BB",
        "flip" => "\u21C6",
        "copy" => "\u2398",
        "cut" => "\u2702",
        "save-block" => "\u2606",
        _ => "\u29C9",
    };

    string valueText = "";
    string? valueError;
    string? valueFor;

    // NOTE: Only a resistor, capacitor or inductor with a plain number has a value to type. A diode has a model name there.
    bool Editable(string reference) =>
        reference.Length > 0 && char.ToUpperInvariant(reference[0]) is 'R' or 'C' or 'L'
        && SchematicEdits.ValueOf(netlist, reference) is { } text && SchematicEdits.TryParseValue(text, out _, out _);

    // True when the selected part has a value to edit. The box is docked at the bottom left of the canvas, clear of the part's actions.
    bool ValueBox()
    {
        if (hasErrors || selected is not { } part || !Editable(part)) return false;
        if (valueFor != part)
        {
            (valueFor, valueError) = (part, null);
            valueText = SchematicEdits.ValueOf(netlist, part)!;
        }
        return true;
    }

    void TypeValue(ChangeEventArgs e) => (valueText, valueError) = (e.Value?.ToString() ?? "", null);

    async Task ValueKey(KeyboardEventArgs e)
    {
        if (selected is not { } part) return;
        switch (e.Key)
        {
            case "Enter":
                await CommitValue(part, null);
                break;
            case "ArrowUp" or "ArrowDown":
                await CommitValue(part, e.Key == "ArrowUp" ? 1 : -1);
                break;
            case "Escape":
                valueFor = null;
                await Focus();
                break;
        }
    }

    // NOTE: A step starts from what is in the box, or from the netlist when the box holds bad text.
    async Task CommitValue(string part, int? step)
    {
        var ok = SchematicEdits.TryParseValue(valueText, out var value, out var error);
        if (!ok && step is not null && SchematicEdits.TryParseValue(SchematicEdits.ValueOf(netlist, part), out value, out _)) (ok, error) = (true, "");
        if (!ok)
        {
            valueError = error;
            return;
        }
        if (step is { } s) value = SchematicEdits.StepE12(value, s);
        var text = SchematicEdits.FormatValue(value);
        (valueText, valueError) = (text, null);
        if (text != SchematicEdits.ValueOf(netlist, part)) await Apply(SchematicEdits.SetValue(netlist, layout, part, text));
    }

    string nameText = "";
    string? nameError;
    string? nameFor;

    // The net of the selected wire, which has a name to type. The box is where the value box is: a wire has no value.
    string? NameBox()
    {
        if (hasErrors || selectedWire is not { } w || w >= layout.Wires.Count || layout.Wires[w].Net == "0") return null;
        var net = layout.Wires[w].Net;
        if (nameFor != net) (nameFor, nameText, nameError) = (net, net, null);
        return net;
    }

    void TypeName(ChangeEventArgs e) => (nameText, nameError) = (e.Value?.ToString() ?? "", null);

    async Task NameKey(KeyboardEventArgs e)
    {
        if (NameBox() is not { } net) return;
        switch (e.Key)
        {
            case "Enter":
                if (!SchematicEdits.TryNetName(nameText, out var error))
                {
                    nameError = error;
                    return;
                }
                nameFor = nameText.Trim();
                if (nameFor != net) await Apply(SchematicEdits.NameNet(netlist, layout, net, nameText));
                break;
            case "Escape":
                nameFor = null;
                await Focus();
                break;
        }
    }

    async Task Act(string action)
    {
        await Focus();
        switch (action)
        {
            case "delete": await DeleteSelected(); break;
            case "rotate": await RotateSelected(); break;
            case "flip": await FlipSelected(); break;
            case "duplicate": await DuplicateSelected(); break;
            case "copy": CopySelection(); break;
            case "cut": await CutSelection(); break;
            case "save-block": StartSave(); break;
        }
    }

    // NOTE: With a view, the four buttons make one row above the part, beyond its labels and the hit circles of its pins.
    // Where the row does not fit above, it goes below. Each centre is clamped so the whole 44 px button stays in the pane.
    // A wire gets one Delete at its middle. A group gets Delete, Copy and Cut over the box of its parts.
    List<(string Action, string Label, string Style)>? ActionSpots()
    {
        Point min, max;
        var wire = false;
        if (selectedWire is { } w && w < layout.Wires.Count)
        {
            var points = layout.Wires[w].Points;
            var (p, q) = (points[(points.Count - 1) / 2], points[points.Count / 2]);
            (min, max) = (new Point((p.X + q.X) / 2, (p.Y + q.Y) / 2), new Point((p.X + q.X) / 2, (p.Y + q.Y) / 2));
            wire = true;
        }
        else if (selected is { } part && outlines.FirstOrDefault(o => o.Reference == part) is { } outline)
        {
            (min, max) = (outline.Min, outline.Max);
        }
        else if (group.Count > 0 && outlines.Where(o => group.Contains(o.Reference)).ToList() is { Count: > 0 } chosen)
        {
            (min, max) = (new Point(chosen.Min(o => o.Min.X), chosen.Min(o => o.Min.Y)), new Point(chosen.Max(o => o.Max.X), chosen.Max(o => o.Max.Y)));
        }
        else return null;

        var sized = view is not null && paneBox[2] > 0;
        (double X, double Y) Clamped(double x, double y)
        {
            const double Half = ActionPixels / 2, Gap = 4;
            return (Math.Clamp(x, Half + Gap, Math.Max(Half + Gap, paneBox[2] - Half - Gap)),
                Math.Clamp(y, Half + Gap, Math.Max(Half + Gap, paneBox[3] - Half - Gap)));
        }
        string Place(double x, double y)
        {
            if (!sized) return "";
            var (cx, cy) = Clamped(x, y);
            return FormattableString.Invariant($"left: {cx:0.#}px; top: {cy:0.#}px");
        }

        Point a = default, b = default;
        if (sized) (a, b) = (view!.WorldToScreen(min), view!.WorldToScreen(max));
        var mx = (a.X + b.X) / 2;
        var names = wire ? new[] { ("delete", "Delete") }
            : group.Count > 0 ? [("delete", "Delete"), ("copy", "Copy"), ("cut", "Cut"), ("save-block", "Save as block")]
            : [("delete", "Delete"), ("rotate", "Rotate"), ("flip", "Flip"), ("duplicate", "Duplicate")];
        if (wire) return [("delete", "Delete", Place(mx, (a.Y + b.Y) / 2))];

        // The row clears the hit circle of a pin, the labels above the outline, and a gap.
        const double Space = ActionGap, Clear = ActionPixels / 2 + LabelPixels + 4;
        var reach = PinHit() * (view?.Zoom ?? 1) + Clear;
        var y = a.Y - reach;
        if (sized && y < ActionPixels / 2 + 4) y = b.Y + reach;
        var first = mx - (names.Length * ActionPixels + (names.Length - 1) * Space) / 2 + ActionPixels / 2;
        var spots = names.Select((n, i) => (n.Item1, n.Item2, Place(first + i * (ActionPixels + Space), y))).ToList();
        if (!sized) return spots;

        // NOTE: A row that would cover a part outside the selection, or lie within a finger of it, moves to the next candidate:
        // above, below, right, left, the four corners, then the same sides one row further out. With none free, the row sits as a
        // bar on the bottom edge of the pane, then the top edge, then at the first free spot of a scan of the pane. Each centre is
        // clamped into the pane. A phone moves a tap onto the nearest button, so a button at the edge of a part takes its tap (#258).
        var others = outlines.Where(o => !group.Contains(o.Reference) && o.Reference != selected)
            .Select(o => (A: view!.WorldToScreen(o.Min), B: view!.WorldToScreen(o.Max))).ToList();
        const double Reach = ActionPixels / 2 + FingerPixels;
        bool Covers(IEnumerable<(double X, double Y)> centres) => centres.Any(c =>
            others.Any(o => c.X + Reach > Math.Min(o.A.X, o.B.X) && c.X - Reach < Math.Max(o.A.X, o.B.X)
                && c.Y + Reach > Math.Min(o.A.Y, o.B.Y) && c.Y - Reach < Math.Max(o.A.Y, o.B.Y)));
        var step = ActionPixels + Space;
        var my = (a.Y + b.Y) / 2;
        var width = names.Length * ActionPixels + (names.Length - 1) * Space;
        // NOTE: The row is a line of buttons from its left end, or a column from its top end.
        var row = (double Left, double Y) => Enumerable.Range(0, names.Length).Select(i => Clamped(Left + ActionPixels / 2 + i * step, Y)).ToList();
        var column = (double X, double Top) => Enumerable.Range(0, names.Length).Select(i => Clamped(X, Top + ActionPixels / 2 + i * step)).ToList();
        var left = mx - width / 2;
        var top = my - width / 2;
        if (!Covers(row(left, y))) return spots;
        var candidates = new List<List<(double X, double Y)>>();
        foreach (var further in new[] { 0.0, step })
        {
            candidates.Add(row(left, a.Y - reach - further));
            candidates.Add(row(left, b.Y + reach + further));
            candidates.Add(column(b.X + reach + further, top));
            candidates.Add(column(a.X - reach - further, top));
            if (further > 0) continue;
            candidates.Add(row(b.X + reach, a.Y - reach));
            candidates.Add(row(a.X - reach - width, a.Y - reach));
            candidates.Add(row(b.X + reach, b.Y + reach));
            candidates.Add(row(a.X - reach - width, b.Y + reach));
        }
        candidates.Add(row(mx - width / 2, paneBox[3]));
        candidates.Add(row(mx - width / 2, 0));
        for (var gy = paneBox[3]; gy >= 0; gy -= step / 2)
        {
            for (var gx = 0.0; gx <= paneBox[2]; gx += step / 2) candidates.Add(row(gx, gy));
        }
        foreach (var centres in candidates)
        {
            if (Covers(centres)) continue;
            return names.Select((n, i) => (n.Item1, n.Item2, FormattableString.Invariant($"left: {centres[i].X:0.#}px; top: {centres[i].Y:0.#}px"))).ToList();
        }
        return spots;
    }

    async Task Apply(SchematicChange change)
    {
        ClearUndo();
        netlist = change.Netlist;
        given = change.Layout;
        Build();
        await Changed.InvokeAsync(change);
    }

    IEnumerable<(string Id, string Text)> HintsLeft() => FirstRun.Where(h => !dismissed.Contains(h.Id));

    async Task LoadHints()
    {
        try
        {
            var saved = await Js.InvokeAsync<string?>("localStorage.getItem", HintsKey);
            foreach (var id in (saved ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)) dismissed.Add(id);
        }
        catch (Exception)
        {
            // NOTE: Storage can be off or blocked. The hints then show again after a reload.
        }
    }

    async Task Done(string id)
    {
        if (!dismissed.Add(id)) return;
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", HintsKey, string.Join(',', dismissed.Order(StringComparer.Ordinal)));
        }
        catch (Exception)
        {
            // NOTE: Storage can be off or full. The hint then shows again after a reload.
        }
    }

    string Pressed(Tool t) => t == tool ? "true" : "false";

    double KnobFace() => Math.Max(KnobRadius, KnobRadius / Zoom());

    static (double X, double Y) KnobPointer(Point at, double position, double radius)
    {
        // NOTE: The pointer sweeps 270 degrees, from 7 o'clock at 0% through noon at 50% to 5 o'clock at 100%.
        var angle = (-135 + 270 * position) * Math.PI / 180;
        return (at.X + radius * Math.Sin(angle), at.Y - radius * Math.Cos(angle));
    }

    static string KnobText(KnobView k, double position) =>
        $"{k.Reference} {position.ToString("0%", CultureInfo.InvariantCulture)} {Knobs.TaperName(k.Taper)}, " +
        $"{SchematicRenderer.Plain(Knobs.Resistance(k.Taper, position, k.Total))} of {SchematicRenderer.Plain(k.Total)} wiper to bottom";

    void KnobDown(KnobView k, PointerEventArgs e)
    {
        if (e.Button > 0) return;
        turning = (k.Reference, e.ClientY, k.Position, k.Position, false);
    }

    void KnobMove(PointerEventArgs e)
    {
        if (turning is not { } t) return;
        var moved = t.Moved || Math.Abs(e.ClientY - t.FromY) > DragSlop;
        turning = t with { Now = moved ? Math.Clamp(t.From + (t.FromY - e.ClientY) / KnobTravel, 0, 1) : t.From, Moved = moved };
    }

    async Task KnobUp()
    {
        if (turning is not { } t) return;
        turning = null;
        if (t.Moved) await Turn(t.Reference, t.Now);
    }

    async Task KnobWheel(KnobView k, WheelEventArgs e)
    {
        if (e.DeltaY != 0) await Turn(k.Reference, k.Position - Math.Sign(e.DeltaY) * WheelStep);
    }

    async Task KnobKey(KnobView k, KeyboardEventArgs e)
    {
        double? to = e.Key switch
        {
            "ArrowUp" or "ArrowRight" => k.Position + KeyStep,
            "ArrowDown" or "ArrowLeft" => k.Position - KeyStep,
            "PageUp" => k.Position + 10 * KeyStep,
            "PageDown" => k.Position - 10 * KeyStep,
            "Home" => 0,
            "End" => 1,
            _ => null,
        };
        if (to is { } position) await Turn(k.Reference, position);
    }

    static string SwitchText(SwitchView w) =>
        $"{w.Reference} {SchematicRenderer.SwitchName(w.Throws)}, " + (w.Throws == 1 ? (w.Position == 1 ? "on" : "off") : $"throw {w.Position}");

    async Task SwitchKey(SwitchView w, KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") await Flip(w.Reference);
    }

    // NOTE: A tap on a switch moves it to its next position: one change, the layout stays and the live run follows.
    async Task Flip(string reference)
    {
        var flipped = SchematicEdits.Flip(netlist, reference);
        if (flipped != netlist) await Apply(new SchematicChange(flipped, layout));
    }

    // NOTE: A knob turn changes only the knob line, so the layout stays and the live run follows.
    async Task Turn(string reference, double position)
    {
        var tuned = Knobs.Turn(netlist, reference, position);
        if (tuned != netlist) await Apply(new SchematicChange(tuned, layout));
    }


    // The value and the node voltages of the part or pin under the pointer, for the hint line.
    string? pointing;
    string? pointedKey;

    // PERF: Each part rect has its text as a title, and a drag renders on each pointer move. ValueOf reads the whole
    // netlist, so the texts are kept until the netlist, the pins or the voltages change (#179).
    readonly Dictionary<string, string> partTexts = [];
    (string Netlist, List<PinView> Pins, IReadOnlyDictionary<string, double>? Voltages)? partTextsFor;

    string PartText(string reference)
    {
        if (partTextsFor is not { } f || !ReferenceEquals(f.Netlist, netlist) || !ReferenceEquals(f.Pins, pins) || !ReferenceEquals(f.Voltages, NodeVoltages))
        {
            partTexts.Clear();
            partTextsFor = (netlist, pins, NodeVoltages);
        }
        if (!partTexts.TryGetValue(reference, out var text))
        {
            text = string.Join(", ", new[] { reference + (SchematicEdits.ValueOf(netlist, reference) is { Length: > 0 } value ? " " + value : "") }
                .Concat(NodesOf(reference).Select(NodeText)));
            partTexts[reference] = text;
        }
        return text;
    }

    string NodeText(string node) =>
        "node " + node + (NodeVoltages is not null && NodeVoltages.TryGetValue(node, out var volts) ? " " + Eng.Format(volts, "V") : "");

    IEnumerable<string> NodesOf(string reference) => pins.Where(p => p.Ref.Reference == reference).Select(p => p.Node).Distinct();

    // NOTE: Only a change of the part or pin under the pointer tells the page, so a move over one part renders nothing.
    async Task PointAt(string reference, string? node)
    {
        var key = reference + "/" + node;
        if (key == pointedKey) return;
        pointedKey = key;
        pointing = node is null ? PartText(reference) : $"{reference}: {NodeText(node)}";
        await Pointed.InvokeAsync(node is null ? NodesOf(reference).ToList() : [node]);
    }

    async Task PointAway()
    {
        if (pointedKey is null) return;
        (pointedKey, pointing) = (null, null);
        await Pointed.InvokeAsync([]);
    }

    static string Label(string kind) => SchematicEdits.IsSwitch(kind)
        ? SchematicRenderer.SwitchName(SchematicEdits.Throws(kind)) + " switch"
        : char.ToUpperInvariant(kind[0]) + kind[1..].Replace('-', ' ');

    static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
