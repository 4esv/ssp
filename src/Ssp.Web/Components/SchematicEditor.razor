@using System.Globalization
@using System.Text.RegularExpressions
@using Ssp.Core.Netlist
@using Ssp.Core.Parts
@using Ssp.Web.Schematic
@using SpiceComponent = SpiceSharp.Components.IComponent
@using LayoutDoc = Ssp.Core.Layout.Layout
@using Point = Ssp.Core.Layout.Point
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

<section class="schematic-editor">
    <div class="schematic-tools" role="toolbar" aria-label="Schematic tools">
        <div class="tool-group" role="group" aria-label="Parts">
            <span class="tool-label">Add a part</span>
            @foreach (var kind in SchematicEdits.Kinds.Keys)
            {
                <button type="button" class="place" data-kind="@kind" disabled="@hasErrors" @onclick="() => Place(kind)">@Label(kind)</button>
            }
        </div>
        <div class="tool-group" role="group" aria-label="Tools">
            <span class="tool-label">Connect</span>
            <button type="button" class="tool" data-tool="wire" aria-pressed="@Pressed(Tool.Wire)" @onclick="() => Select(Tool.Wire)">Wire</button>
            <button type="button" class="tool" data-tool="ground" aria-pressed="@Pressed(Tool.Ground)" @onclick="() => Select(Tool.Ground)">Ground</button>
        </div>
    </div>
    <p class="schematic-hint" role="status">@Hint()</p>
    @if (undo is { } undoable)
    {
        <p class="delete-status" role="status">Deleted @undoable.Name. <button type="button" @onclick="Undo">Undo</button></p>
    }
    <div class="schematic-body">
    <div class="palette" role="group" aria-label="Parts palette">
        @foreach (var kind in SchematicEdits.Kinds.Keys)
        {
            <button type="button" class="palette-item" data-kind="@kind" disabled="@hasErrors"
                    title="Add a @Label(kind).ToLowerInvariant() at the centre of the canvas"
                    @onclick="() => PaletteAdd(kind)">
                <span class="palette-symbol">@((MarkupString)SymbolOf(kind))</span>
                <span class="palette-name">@Label(kind)</span>
            </button>
        }
    </div>
    <figure class="schematic" aria-label="Schematic" tabindex="0" @ref="pane" data-view="@(view is null ? null : "")" style="@StageStyle()"
            @onkeydown="Key" @onkeydown:preventDefault="@(selected is not null || selectedWire is not null)"
            @onwheel="Wheel" @onwheel:preventDefault>
        @if (svg is null && !hasErrors)
        {
            <div class="schematic-blank" @onclick="CanvasClick">
                <p class="schematic-empty">The schematic is empty. Add a part: click one in the palette, or use the toolbar. Then tap a pin and tap a second pin to join them, or use Ground to mark a pin as 0 V.</p>
            </div>
        }
        @if (svg is not null)
        {
            @((MarkupString)svg)
            <svg class="schematic-pins" xmlns="http://www.w3.org/2000/svg" viewBox="@viewBox" @onclick="CanvasClick"
                 @onpointerdown="PanDown" @onpointermove="PanMove" @onpointerup="PanUp" @onpointercancel="PanUp">
                @for (var i = 0; i < layout.Wires.Count; i++)
                {
                    var wireIndex = i;
                    <polyline class="@(wireIndex == selectedWire ? "wire-hit selected" : "wire-hit")" data-wire="@wireIndex"
                              points="@WirePoints(layout.Wires[wireIndex])" @onclick="() => SelectWire(wireIndex)" @onclick:stopPropagation />
                }
                @foreach (var part in outlines)
                {
                    <rect class="@(part.Reference == selected ? "part selected" : "part")" data-ref="@part.Reference"
                          x="@N(part.Min.X)" y="@N(part.Min.Y)" width="@N(part.Max.X - part.Min.X)" height="@N(part.Max.Y - part.Min.Y)"
                          @onpointerdown="e => PartDown(part.Reference, e)" @onpointermove="PartMove" @onpointerup="PartUp" @onpointercancel="PartCancel"
                          @onclick="() => SelectPart(part.Reference)" @onclick:stopPropagation>
                        <title>@part.Reference</title>
                    </rect>
                }
                @if (moving is { } m && ghost is { } g)
                {
                    <rect class="part ghost" x="@N(m.Min.X + g.X)" y="@N(m.Min.Y + g.Y)" width="@N(m.Max.X - m.Min.X)" height="@N(m.Max.Y - m.Min.Y)" />
                }
                @foreach (var pin in pins)
                {
                    <circle class="pin-hit" cx="@N(pin.Position.X)" cy="@N(pin.Position.Y)" r="@N(HitRadius)" @onclick="() => Click(pin.Ref)" @onclick:stopPropagation />
                    <circle class="@(pin.Ref == pending ? "pin pending" : "pin")" data-ref="@pin.Ref.Reference" data-pin="@pin.Ref.Pin"
                            cx="@N(pin.Position.X)" cy="@N(pin.Position.Y)" r="5" @onclick="() => Click(pin.Ref)" @onclick:stopPropagation>
                        <title>@pin.Ref.Reference pin @(pin.Ref.Pin + 1), node @pin.Node</title>
                    </circle>
                }
                @if (pending is { } from && pins.FirstOrDefault(p => p.Ref == from) is { } source)
                {
                    <g class="pin-add" role="button" aria-label="Add a part to @from.Reference pin @(from.Pin + 1)" @onclick="ToggleMenu" @onclick:stopPropagation>
                        <circle class="pin-add-hit" cx="@N(source.Position.X + HitRadius * 2)" cy="@N(source.Position.Y - HitRadius * 2)" r="@N(HitRadius)" />
                        <text class="pin-add-sign" x="@N(source.Position.X + HitRadius * 2)" y="@N(source.Position.Y - HitRadius * 2)" text-anchor="middle" dominant-baseline="central">+</text>
                    </g>
                }
            </svg>
            @if (menuOpen && pending is { } origin)
            {
                <div class="pin-menu" role="menu" aria-label="Add a part to @origin.Reference pin @(origin.Pin + 1)">
                    @foreach (var kind in SchematicEdits.Kinds.Keys)
                    {
                        <button type="button" role="menuitem" data-kind="@kind" @onclick="() => AddFromPin(kind)">@Label(kind)</button>
                    }
                </div>
            }
            @if (BarStyle() is { } barStyle)
            {
                <div class="selection-bar" role="toolbar" aria-label="Selection" style="@barStyle">
                    <button type="button" data-action="delete" @onclick="DeleteSelected">Delete</button>
                    <button type="button" data-action="rotate" disabled="@(selected is null)" @onclick="RotateSelected">Rotate</button>
                    <button type="button" data-action="flip" disabled="@(selected is null)" @onclick="FlipSelected">Flip</button>
                    <button type="button" data-action="duplicate" disabled="@(selected is null)" @onclick="DuplicateSelected">Duplicate</button>
                </div>
            }
            <div class="schematic-zoom" role="group" aria-label="Zoom">
                <button type="button" data-zoom="out" aria-label="Zoom out" title="Zoom out (-)" disabled="@(view is { Zoom: <= ViewTransform.MinZoom })" @onclick="() => ZoomStep(1 / ZoomStepFactor)">&minus;</button>
                <output class="zoom-level" aria-label="Zoom level">@(view is { } v ? $"{(int)Math.Round(v.Zoom * 100)}%" : "Fit")</output>
                <button type="button" data-zoom="in" aria-label="Zoom in" title="Zoom in (+)" disabled="@(view is { Zoom: >= ViewTransform.MaxZoom })" @onclick="() => ZoomStep(ZoomStepFactor)">+</button>
                <button type="button" data-zoom="fit" title="Fit the circuit (0)" @onclick="FitView">Fit</button>
            </div>
        }
    </figure>
    </div>
</section>

@code {
    enum Tool { Wire, Ground }

    sealed record PinView(PinRef Ref, string Node, Point Position);

    sealed record PartView(string Reference, Point Min, Point Max);

    static readonly Regex ViewBox = new("viewBox=\"([^\"]*)\"");

    [Parameter] public string Netlist { get; set; } = "";

    /// <summary>The layout of the netlist. With no layout the editor starts from the auto-placement.</summary>
    [Parameter] public LayoutDoc? Layout { get; set; }

    /// <summary>Gets the netlist and the layout after each place, wire and ground.</summary>
    [Parameter] public EventCallback<SchematicChange> Changed { get; set; }

    string? seenNetlist;
    LayoutDoc? seenLayout;
    string netlist = "";
    LayoutDoc layout = new([], []);
    LayoutDoc? given;
    PartMap? parts;
    bool hasErrors;
    string? svg;
    string viewBox = "";
    List<PinView> pins = [];
    List<PartView> outlines = [];
    string? selected;
    int? selectedWire;

    // NOTE: The state before the last delete, kept for UndoSeconds. Any other edit drops it.
    const int UndoSeconds = 8;
    (string Name, SchematicChange Before)? undo;
    CancellationTokenSource? undoTimer;
    Tool? tool = Tool.Wire;

    // NOTE: The hit circle is 24 units across or more, the least that a finger can hit.
    const double HitRadius = 12;
    PinRef? pending;

    // NOTE: A drag under this many pixels is a click.
    const double DragSlop = 4;

    ElementReference pane;
    IJSObjectReference? module;

    // The view of the canvas, in pixels of the pane. World is in units of the view box.
    // NOTE: Every pointer position goes through the view, so place, move and wire hit the same grid point at any zoom.
    // NOTE: Null is the CSS fit, so a page with no pointer never loads the module. The first pointer or key use makes it a view.
    const double ZoomStepFactor = 1.25;
    const double FitMargin = 24;
    ViewTransform? view;
    (double X, double Y, double W, double H) box;

    // The pointers that are down on the empty canvas, by id, in client pixels. One pans, two pan and pinch.
    readonly Dictionary<long, Point> touches = [];
    double[] paneBox = [0, 0, 0, 0];
    bool panMoved;
    Point panFrom;

    // Whether the menu of kinds for the selected pin is open.
    bool menuOpen;

    // A part that the pointer moves: its outline at the start, the pointer at the start, the scale at the start, and the snapped offset.
    PartView? moving;
    Point moveFrom;
    double moveScale = 1;
    Point? ghost;
    Point moveDelta;
    bool moveMoved;

    // NOTE: The editor keeps its own copy, so a parent that does not pass the change back still sees each edit.
    protected override void OnParametersSet()
    {
        if (Netlist == seenNetlist && ReferenceEquals(Layout, seenLayout)) return;
        seenNetlist = Netlist;
        seenLayout = Layout;
        netlist = Netlist;
        given = Layout;
        Build();
        view = null;
    }

    void Build()
    {
        ClearUndo();
        selectedWire = null;
        pending = null;
        menuOpen = false;
        var wasBlank = svg is null;
        svg = null;
        pins = [];
        outlines = [];
        var circuit = NetlistLoader.Load(netlist);
        hasErrors = circuit.Diagnostics.Any(d => d.Severity == Severity.Error);
        if (hasErrors) return;

        parts = PartMap.Resolve(circuit, SchematicView.Table);
        layout = given ?? AutoPlacer.Place(circuit, circuit.Directives);
        if (!circuit.Circuit.OfType<SpiceComponent>().Any()) return;

        svg = SchematicRenderer.ToSvg(circuit, layout, parts);
        if (wasBlank) view = null;
        viewBox = ViewBox.Match(svg).Groups[1].Value;
        var v = viewBox.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(t => double.Parse(t, CultureInfo.InvariantCulture)).ToArray();
        box = (v[0], v[1], v[2], v[3]);
        var placements = layout.Parts.ToDictionary(p => p.Reference, StringComparer.OrdinalIgnoreCase);
        foreach (var c in circuit.Circuit.OfType<SpiceComponent>().OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
        {
            if (!placements.TryGetValue(c.Name, out var placement)) continue;
            var row = parts.Parts.GetValueOrDefault(c.Name);
            var (min, max) = SchematicRenderer.Outline(c, placement, row);
            outlines.Add(new PartView(c.Name, min, max));
            var positions = SchematicRenderer.Pins(c, placement, row);
            pins.AddRange(positions.Select((p, i) => new PinView(new PinRef(c.Name, i), c.Nodes[i], p)));
        }
        foreach (var pot in SchematicRenderer.Elements(circuit, parts).Where(e => e.Kind == "pot"))
        {
            if (!(placements.TryGetValue(pot.Reference, out var placement) || placements.TryGetValue(pot.Members[0], out placement))) continue;
            var (min, max) = SchematicRenderer.PotOutline(placement);
            outlines.Add(new PartView(pot.Reference, min, max));
            pins.AddRange(SchematicRenderer.PotPins(placement).Select((p, i) => new PinView(new PinRef(pot.Reference, i), pot.Nodes[i], p)));
        }
        if (!outlines.Any(p => p.Reference == selected)) selected = null;
    }

    public async ValueTask DisposeAsync()
    {
        undoTimer?.Cancel();
        if (module is not null) await module.DisposeAsync();
    }

    // NOTE: The module loads on the first pointer use, so a page with no pointer never loads it.
    async Task<IJSObjectReference> Module() =>
        module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/schematic-canvas.js");

    static string SymbolOf(string kind) => Symbols.Find(kind switch
    {
        "battery" or "source" => "vsource",
        "jack-in" or "jack-out" => "resistor",
        _ => kind,
    })?.Svg ?? "";

    // The pane box in client pixels: left, top, width, height.
    async Task<double[]> PaneBox() =>
        paneBox = await (await Module()).InvokeAsync<double[]>("paneBox", pane);

    async Task<ViewTransform> Current()
    {
        if (view is not null) return view;
        var b = await PaneBox();
        return view = ViewTransform.Fit(box.X, box.Y, box.W, box.H, b[2], b[3], FitMargin);
    }

    // The world point of a client position, and whether the position is on the canvas.
    async Task<(Point At, bool Inside)> ToCanvas(double x, double y)
    {
        var b = await PaneBox();
        var inside = x >= b[0] && x <= b[0] + b[2] && y >= b[1] && y <= b[1] + b[3];
        var current = svg is null ? ViewTransform.Identity : await Current();
        return (current.ScreenToWorld(new Point(x - b[0], y - b[1])), inside);
    }

    string StageStyle() => view is not { } v ? "" : FormattableString.Invariant(
        $"--w: {box.W}px; --h: {box.H}px; --x: {v.X + box.X * v.Zoom}px; --y: {v.Y + box.Y * v.Zoom}px; --z: {v.Zoom}");

    async Task FitView()
    {
        if (svg is null) return;
        view = null;
        await Current();
    }

    async Task ZoomStep(double factor)
    {
        var b = await PaneBox();
        view = (await Current()).ZoomAbout(new Point(b[2] / 2, b[3] / 2), factor);
    }

    // NOTE: A pinch on a trackpad is a wheel with Ctrl held, so it zooms with a finer step than the wheel.
    async Task Wheel(WheelEventArgs e)
    {
        if (svg is null) return;
        var b = await PaneBox();
        var lines = e.DeltaMode == 1 ? 16 : 1;
        var factor = Math.Exp(-e.DeltaY * lines * (e.CtrlKey ? 0.01 : 0.0015));
        view = (await Current()).ZoomAbout(new Point(e.ClientX - b[0], e.ClientY - b[1]), factor);
    }

    async Task PanDown(PointerEventArgs e)
    {
        if (e.Button > 0 || moving is not null) return;
        if (touches.Count == 0)
        {
            panMoved = false;
            panFrom = new Point(e.ClientX, e.ClientY);
        }
        touches[e.PointerId] = new Point(e.ClientX, e.ClientY);
        await PaneBox();
        await Current();
    }

    void PanMove(PointerEventArgs e)
    {
        // NOTE: Until PanDown has made the view, the moves are lost.
        if (view is null || !touches.TryGetValue(e.PointerId, out var last) || moving is not null) return;
        var now = new Point(e.ClientX, e.ClientY);
        var others = touches.Where(t => t.Key != e.PointerId).Select(t => t.Value).ToList();
        if (others.Count == 1)
        {
            var o = others[0];
            var before = Math.Max(Distance(last, o), 1);
            var mid = new Point((now.X + o.X) / 2 - paneBox[0], (now.Y + o.Y) / 2 - paneBox[1]);
            var midBefore = new Point((last.X + o.X) / 2, (last.Y + o.Y) / 2);
            view = view!.ZoomAbout(mid, Distance(now, o) / before).Pan((now.X + o.X) / 2 - midBefore.X, (now.Y + o.Y) / 2 - midBefore.Y);
            panMoved = true;
        }
        else if (others.Count == 0)
        {
            // NOTE: A drag under the slop is a click, so the canvas does not move for it.
            if (!panMoved && Math.Abs(now.X - panFrom.X) <= DragSlop && Math.Abs(now.Y - panFrom.Y) <= DragSlop) return;
            panMoved = true;
            view = view!.Pan(now.X - last.X, now.Y - last.Y);
        }
        touches[e.PointerId] = now;
    }

    void PanUp(PointerEventArgs e) => touches.Remove(e.PointerId);

    static double Distance(Point a, Point b) => Math.Sqrt((a.X - b.X) * (a.X - b.X) + (a.Y - b.Y) * (a.Y - b.Y));

    // NOTE: The part lands at the centre of the visible canvas. With no pane box, as in a test, it lands in the next column.
    async Task PaletteAdd(string kind)
    {
        if (hasErrors) return;
        double[]? b = null;
        try { b = await PaneBox(); }
        catch (JSException) { }
        if (b is not { Length: >= 4 })
        {
            await Place(kind);
            return;
        }
        var (at, _) = await ToCanvas(b[0] + b[2] / 2, b[1] + b[3] / 2);
        await PlaceAt(kind, at);
    }

    // NOTE: A tap on the empty canvas cancels the connection.
    void CanvasClick(MouseEventArgs e)
    {
        if (panMoved) return;
        (pending, menuOpen) = (null, false);
    }

    void ToggleMenu() => menuOpen = !menuOpen;

    async Task AddFromPin(string kind)
    {
        if (pending is not { } pin || parts is null) return;
        var change = SchematicEdits.PlaceFrom(netlist, layout, parts, kind, pin);
        await Apply(change);
        selected = change.Layout.Parts[^1].Reference;
    }

    async Task PlaceAt(string kind, Point at)
    {
        var change = SchematicEdits.PlaceAt(netlist, layout, kind, at);
        await Apply(change);
        // NOTE: Place puts the new part last in the layout.
        selected = change.Layout.Parts[^1].Reference;
    }

    async Task PartDown(string reference, PointerEventArgs e)
    {
        if (e.Button > 0) return;
        SelectPart(reference);
        moving = outlines.Single(p => p.Reference == reference);
        moveFrom = new Point(e.ClientX, e.ClientY);
        moveScale = 1 / (await Current()).Zoom;
        moveDelta = new Point(0, 0);
        moveMoved = false;
    }

    void PartMove(PointerEventArgs e)
    {
        if (moving is null) return;
        var (px, py) = (e.ClientX - moveFrom.X, e.ClientY - moveFrom.Y);
        moveMoved |= Math.Abs(px) > DragSlop || Math.Abs(py) > DragSlop;
        if (!moveMoved) return;
        moveDelta = new Point(px * moveScale, py * moveScale);
        // NOTE: The ghost shows where the part lands. It is the offset of the snapped position, not of the pointer.
        var at = layout.Parts.FirstOrDefault(p => string.Equals(p.Reference, moving.Reference, StringComparison.OrdinalIgnoreCase) || string.Equals(p.Reference, moving.Reference + "_1", StringComparison.OrdinalIgnoreCase));
        ghost = at is null ? moveDelta : new Point(SchematicEdits.Snap(at.X + moveDelta.X) - at.X, SchematicEdits.Snap(at.Y + moveDelta.Y) - at.Y);
    }

    async Task PartUp()
    {
        if (moving is not { } part) return;
        var moved = moveMoved;
        (moving, ghost) = (null, null);
        if (moved) await Apply(SchematicEdits.Drag(netlist, layout, parts!, part.Reference, moveDelta.X, moveDelta.Y));
    }

    void PartCancel() => (moving, ghost) = (null, null);

    async Task Place(string kind)
    {
        var change = SchematicEdits.Place(netlist, layout, kind);
        await Apply(change);
        // NOTE: Place puts the new part last in the layout.
        selected = change.Layout.Parts[^1].Reference;
    }

    string Hint() =>
        pending is { } p ? $"Connecting from {p.Reference} pin {p.Pin + 1}. Tap another pin."
        : selectedWire is not null ? "Wire selected: Delete remove"
        : selected is { } s ? $"{s} selected: R rotate, H/V flip, arrows move, Delete remove"
        : tool == Tool.Wire ? "Wire: click a pin"
        : tool == Tool.Ground ? "Ground: click a pin"
        : "Choose a tool, or place a part.";

    void Select(Tool next)
    {
        tool = tool == next ? null : next;
        pending = null;
        selected = null;
        selectedWire = null;
    }

    async Task Click(PinRef pin)
    {
        if (panMoved) return;
        if (tool == Tool.Ground)
        {
            await Apply(SchematicEdits.Ground(netlist, layout, parts!, pin));
        }
        else if (pending is null)
        {
            pending = pin;
        }
        else if (pending == pin)
        {
            (pending, menuOpen) = (null, false);
        }
        else
        {
            await Apply(SchematicEdits.Wire(netlist, layout, parts!, pending, pin));
        }
    }

    // NOTE: Escape clears the selection, so that Tab can move the focus out of the schematic again.
    async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") (pending, menuOpen) = (null, false);
        switch (e.Key)
        {
            case "+" or "=":
                await ZoomStep(ZoomStepFactor);
                return;
            case "-" or "_":
                await ZoomStep(1 / ZoomStepFactor);
                return;
            case "0":
                await FitView();
                return;
        }
        if (e.Key == "Escape") selectedWire = null;
        if (e.Key is "Delete" or "Backspace" && (selected is not null || selectedWire is not null))
        {
            await DeleteSelected();
            return;
        }
        if (selected is not { } part) return;
        const int Step = Symbols.Grid;
        SchematicChange? change = e.Key switch
        {
            "r" or "R" => SchematicEdits.Rotate(netlist, layout, part),
            "h" or "H" => SchematicEdits.Flip(netlist, layout, part, leftToRight: true),
            "v" or "V" => SchematicEdits.Flip(netlist, layout, part, leftToRight: false),
            "ArrowLeft" => SchematicEdits.Move(netlist, layout, part, -Step, 0),
            "ArrowRight" => SchematicEdits.Move(netlist, layout, part, Step, 0),
            "ArrowUp" => SchematicEdits.Move(netlist, layout, part, 0, -Step),
            "ArrowDown" => SchematicEdits.Move(netlist, layout, part, 0, Step),
            "d" or "D" when e.MetaKey || e.CtrlKey => SchematicEdits.Duplicate(netlist, layout, part),
            _ => null,
        };
        if (e.Key == "Escape") selected = null;
        if (change is null) return;

        await Apply(change);
        // NOTE: Duplicate puts the copy last in the layout.
        if (e.Key is "d" or "D") selected = change.Layout.Parts[^1].Reference;
    }

    static string WirePoints(Ssp.Core.Layout.WireRoute wire) => string.Join(' ', wire.Points.Select(p => $"{N(p.X)},{N(p.Y)}"));

    void SelectPart(string reference) => (selected, selectedWire) = (reference, null);

    void SelectWire(int index)
    {
        if (panMoved) return;
        (selected, selectedWire, pending, menuOpen) = (null, index, null, false);
    }

    void ClearUndo()
    {
        undoTimer?.Cancel();
        undo = null;
    }

    async Task DeleteSelected()
    {
        var before = new SchematicChange(netlist, layout);
        SchematicChange change;
        string name;
        if (selectedWire is { } w && parts is not null)
        {
            (name, change) = ("wire", SchematicEdits.DeleteWire(netlist, layout, parts, w));
        }
        else if (selected is { } part)
        {
            (name, change) = (part, SchematicEdits.Delete(netlist, layout, part));
        }
        else return;

        selected = null;
        await Apply(change);
        undo = (name, before);
        undoTimer = new CancellationTokenSource();
        _ = ExpireUndo(undoTimer.Token);
    }

    async Task ExpireUndo(CancellationToken token)
    {
        try { await Task.Delay(TimeSpan.FromSeconds(UndoSeconds), token); }
        catch (TaskCanceledException) { return; }
        await InvokeAsync(() =>
        {
            undo = null;
            StateHasChanged();
        });
    }

    async Task Undo()
    {
        if (undo is not { } last) return;
        await Apply(last.Before);
    }

    async Task RotateSelected()
    {
        if (selected is { } part) await Apply(SchematicEdits.Rotate(netlist, layout, part));
    }

    async Task FlipSelected()
    {
        if (selected is { } part) await Apply(SchematicEdits.Flip(netlist, layout, part, leftToRight: true));
    }

    async Task DuplicateSelected()
    {
        if (selected is not { } part) return;
        var change = SchematicEdits.Duplicate(netlist, layout, part);
        await Apply(change);
        selected = change.Layout.Parts[^1].Reference;
    }

    // NOTE: With a view, the bar sits under the selection, or above it at the edge, and stays in the pane. With the
    // CSS fit there is no pixel position, so the style is empty and the bar sits at the foot of the pane.
    string? BarStyle()
    {
        Point min, max;
        if (selectedWire is { } w && w < layout.Wires.Count)
        {
            var points = layout.Wires[w].Points;
            (min, max) = (new Point(points.Min(p => p.X), points.Min(p => p.Y)), new Point(points.Max(p => p.X), points.Max(p => p.Y)));
        }
        else if (selected is { } part && outlines.FirstOrDefault(o => o.Reference == part) is { } outline)
        {
            (min, max) = (outline.Min, outline.Max);
        }
        else return null;
        if (view is not { } v || paneBox[2] <= 0) return "";

        const double BarWidth = 200, BarHeight = 52, Gap = 8;
        var (a, b) = (v.WorldToScreen(min), v.WorldToScreen(max));
        var left = Math.Clamp(a.X, Gap, Math.Max(Gap, paneBox[2] - BarWidth - Gap));
        var top = b.Y + Gap + BarHeight <= paneBox[3] ? b.Y + Gap : Math.Max(Gap, a.Y - BarHeight - Gap);
        return FormattableString.Invariant($"left: {left:0.#}px; top: {top:0.#}px; bottom: auto");
    }

    async Task Apply(SchematicChange change)
    {
        netlist = change.Netlist;
        given = change.Layout;
        Build();
        await Changed.InvokeAsync(change);
    }

    string Pressed(Tool t) => t == tool ? "true" : "false";

    static string Label(string kind) => char.ToUpperInvariant(kind[0]) + kind[1..].Replace('-', ' ');

    static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
