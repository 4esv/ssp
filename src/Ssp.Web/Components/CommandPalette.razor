@using Ssp.Web.Editing

@if (Mode == PaletteMode.Palette)
{
    <div class="command-palette" role="dialog" aria-label="Command palette">
        <input @ref="search" type="text" autocomplete="off" spellcheck="false" aria-label="Search actions" placeholder="Type an action"
               value="@query" @oninput="e => Search(e.Value?.ToString() ?? string.Empty)" @onkeydown="Key" />
        <ul class="roster">
            @foreach (var (shortcut, index) in Matches().Select((s, i) => (s, i)))
            {
                <li class="@(index == active ? "active" : null)">
                    <button type="button" @onclick="() => Choose(shortcut)">
                        <span>@shortcut.Label</span> <kbd>@shortcut.Keys</kbd>
                    </button>
                </li>
            }
        </ul>
    </div>
}
else if (Mode == PaletteMode.Sheet)
{
    <div class="shortcut-sheet" role="dialog" aria-label="Keyboard shortcuts">
        <button class="ctl btn" type="button" @onclick="Closed"><span class="lbl">Close</span><i class="caret"></i></button>
        <section class="start-here" aria-label="Start here">
            <h2>Start here</h2>
            <ul>
                <li>Tap a part name in the palette to add that part to the canvas.</li>
                <li>Tap a pin. A + shows at each free side of the pin. Tap a +, then pick a part. The new part joins the pin with a wire.</li>
                <li>To join two pins, tap a pin, tap a +, pick Connect to a pin, then tap the other pin.</li>
                <li>To mark the input and the output, tap a pin, then tap Jack in or Jack out.</li>
                <li>The results update after each edit. Run solves the circuit again.</li>
                <li>In the Clip tab, Play clip sends a sample through the circuit and a speaker cabinet.</li>
            </ul>
            <p><a class="ctl lnk" href="docs/index.html" target="_top">Read the docs</a></p>
        </section>
        <table>
            <thead><tr><th>Action</th><th>Keys</th></tr></thead>
            <tbody>
                @foreach (var shortcut in Shortcuts.All)
                {
                    <tr><td>@shortcut.Label</td><td>@shortcut.Keys</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    public enum PaletteMode { None, Palette, Sheet }

    [Parameter] public PaletteMode Mode { get; set; }
    [Parameter] public EventCallback<Shortcut> Chosen { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    ElementReference search;
    string query = "";
    int active;
    bool wasOpen;

    IEnumerable<Shortcut> Matches()
    {
        var words = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return Shortcuts.All.Where(s => words.All(w => s.Label.Contains(w, StringComparison.OrdinalIgnoreCase)));
    }

    void Search(string text)
    {
        query = text;
        active = 0;
    }

    async Task Key(KeyboardEventArgs e)
    {
        var count = Matches().Count();
        if (e.Key == "ArrowDown" && count > 0)
        {
            active = (active + 1) % count;
        }
        else if (e.Key == "ArrowUp" && count > 0)
        {
            active = (active + count - 1) % count;
        }
        else if (e.Key == "Enter" && !e.CtrlKey && !e.MetaKey && Matches().ElementAtOrDefault(active) is { } pick)
        {
            await Choose(pick);
        }
    }

    Task Choose(Shortcut shortcut) => Chosen.InvokeAsync(shortcut);

    protected override void OnParametersSet()
    {
        var open = Mode == PaletteMode.Palette;
        if (open && !wasOpen)
        {
            query = "";
            active = 0;
        }
        wasOpen = open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Mode == PaletteMode.Palette && !focused)
        {
            focused = true;
            await search.FocusAsync();
        }
        else if (Mode != PaletteMode.Palette)
        {
            focused = false;
        }
    }

    bool focused;
}
