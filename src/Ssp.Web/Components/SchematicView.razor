@using Ssp.Core.Netlist
@using Ssp.Core.Parts
@using Ssp.Web.Schematic
@using SpiceComponent = SpiceSharp.Components.IComponent

<figure class="schematic" aria-label="Schematic">
    @if (Svg(Netlist) is { } svg)
    {
        @((MarkupString)svg)
    }
</figure>

@code {
    /// <summary>The shipped parts table.</summary>
    internal static readonly PartsTable Table = LoadParts();

    [Parameter] public string Netlist { get; set; } = "";

    /// <summary>The schematic SVG for a netlist, or null when the netlist has errors or no components.</summary>
    public static string? Svg(string netlist, string? layout = null) => Drawing(netlist, layout)?.Svg;

    /// <summary>
    /// The drawing of a netlist, with the box of each part and of each piece of text, or null when it has no schematic.
    /// A layout file, such as the hand layout of a library circuit, places the parts and wires. Without one the parts are placed.
    /// </summary>
    public static SchematicDrawing? Drawing(string netlist, string? layout = null)
    {
        var circuit = NetlistLoader.Load(netlist);
        if (!Drawable(circuit)) return null;
        var placed = layout is null ? AutoPlacer.Place(circuit, circuit.Directives) : Ssp.Core.Layout.Layout.Parse(layout);
        return SchematicRenderer.Draw(circuit, placed, PartMap.Resolve(circuit, Table));
    }

    /// <summary>True when the circuit has no errors and has components, so it has a schematic.</summary>
    public static bool Drawable(LoadedCircuit circuit) =>
        circuit.Diagnostics.All(d => d.Severity != Severity.Error) && circuit.Circuit.OfType<SpiceComponent>().Any();

    static PartsTable LoadParts()
    {
        // NOTE: The app is static. The build embeds models/parts.toml in this assembly.
        using var stream = typeof(SchematicView).Assembly.GetManifestResourceStream("parts.toml")!;
        using var reader = new StreamReader(stream);
        return Ssp.Core.Parts.Parts.Parse(reader.ReadToEnd(), "parts.toml");
    }
}
