@using Microsoft.JSInterop
@using Ssp.Core.Audio
@implements IAsyncDisposable
@inject ISimulationHost Host
@inject IJSRuntime Js

<section class="live-monitor">
    <h2>Live monitor</h2>
    <p class="monitor-note">monitor, not real time</p>
    <p class="panel-hint">Press Start monitor to hear your input through the circuit. The netlist needs an ssp:input node.</p>

    <button type="button" class="monitor-start" @onclick="Start" disabled="@(running || starting)">Start monitor</button>
    <button type="button" class="monitor-stop" @onclick="Stop" disabled="@(!running)">Stop monitor</button>

    <p class="monitor-latency">Latency: @(latency is { } ms ? ms.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "–") ms</p>
    <p class="monitor-dropped">Dropped chunks: @(dropped + failed)</p>
    <p class="monitor-status" role="status">@status</p>
</section>

@code {
    /// <summary>The netlist that the monitor runs. It needs an <c>ssp:input</c> node.</summary>
    [Parameter] public string Netlist { get; set; } = "";

    IJSObjectReference? module;
    DotNetObjectReference<LiveMonitor>? self;
    Hosting.IMonitorHost? monitor;
    bool running;
    bool starting;
    double? latency;
    long dropped;
    long failed;
    int failedInRow;
    int rate;
    string? firstError;
    string status = "";

    // NOTE: A failed chunk is silence, and the session restarts from the operating point. The monitor stops after this many in a row.
    const int MaxFailedInRow = 20;

    async Task Start()
    {
        monitor = Host as Hosting.IMonitorHost;
        if (monitor is null)
        {
            status = "This host cannot run the monitor.";
            return;
        }

        starting = true;
        status = "Starting…";
        try
        {
            module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/live-monitor.js");
            rate = await module.InvokeAsync<int>("open");
            await monitor.MonitorStart(Netlist, rate);
            self = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("begin", self, MonitorSession.ChunkSamples);
            running = true;
            latency = null;
            dropped = failed = failedInRow = 0;
            firstError = null;
            status = RunningStatus();
        }
        catch (Exception e)
        {
            status = "Monitor failed: " + e.Message;
            await Stop();
        }
        finally
        {
            starting = false;
        }
    }

    async Task Stop()
    {
        running = false;
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("close");
            }
            catch (JSException)
            {
                // NOTE: A start that failed before the microphone opened has nothing to close.
            }
        }

        if (monitor is not null)
        {
            await monitor.MonitorStop();
        }

        self?.Dispose();
        self = null;
    }

    string RunningStatus() =>
        $"Running at {rate} Hz, {MonitorSession.ChunkSamples} samples a chunk. Use headphones."
        + (failed > 0 ? $" Dropped {failed} chunks. First error: {firstError}" : "");

    async Task StopWith(string message)
    {
        await Stop();
        status = $"The monitor stopped: {message.TrimEnd('.')}. Press Start to try again.";
        StateHasChanged();
    }

    /// <summary>
    /// Called from live-monitor.js with one input chunk. Returns the output chunk. A chunk that fails is silence and
    /// counts as dropped. The solver state after a failed step is dead, so the session restarts from the operating point.
    /// </summary>
    [JSInvokable]
    public async Task<double[]> Process(double[] chunk)
    {
        try
        {
            var output = await monitor!.MonitorProcess(chunk);
            failedInRow = 0;
            return output;
        }
        catch (Exception e) when (running)
        {
            failed++;
            failedInRow++;
            firstError ??= e.Message;
            if (failedInRow >= MaxFailedInRow)
            {
                await StopWith(e.Message);
                return new double[chunk.Length];
            }

            try
            {
                await monitor!.MonitorStop();
                await monitor.MonitorStart(Netlist, rate);
                status = RunningStatus();
                StateHasChanged();
            }
            catch (Exception restart)
            {
                await StopWith(restart.Message);
            }

            return new double[chunk.Length];
        }
    }

    /// <summary>Called from live-monitor.js when a call to <see cref="Process"/> fails in the interop. The monitor stops.</summary>
    [JSInvokable]
    public Task Fail(string message) => running ? StopWith(message) : Task.CompletedTask;

    /// <summary>Called from live-monitor.js after each chunk plays.</summary>
    [JSInvokable]
    public Task Report(double milliseconds, long droppedChunks)
    {
        latency = milliseconds;
        dropped = droppedChunks;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (running)
        {
            await Stop();
        }

        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }
}
