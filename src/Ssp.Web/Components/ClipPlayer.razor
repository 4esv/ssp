@using Microsoft.AspNetCore.Components.Forms
@using System.Reflection
@using Ssp.Core
@using Ssp.Core.Audio
@using Microsoft.JSInterop
@inject ISimulationHost Host
@inject IJSRuntime Js
@implements IDisposable

<section class="clip-player">
    <h2>Clip</h2>
    <p class="panel-hint">Play a guitar clip through the circuit. Press Play clip, or load your own WAV file first.</p>

    <label>
        WAV file
        <InputFile OnChange="Upload" accept=".wav,audio/wav" />
    </label>
    <p class="clip-source">@sourceName</p>

    <button type="button" class="clip-play" @onclick="() => Try(Netlist)" disabled="@busy">Play clip</button>
    @if (busy)
    {
        <button type="button" class="clip-cancel" @onclick="Cancel">Cancel</button>
    }
    <button type="button" class="clip-download" @onclick="Download" disabled="@(output is null)">Download WAV</button>

    <p class="clip-status" role="status">@status</p>
</section>

@code {
    const string BundledName = "Bundled clip";
    const int MaxUploadBytes = 20 * 1024 * 1024;
    static readonly int[] Oversamples = [1, 2, 4, 8];

    // A peak below this level, in dBFS, is silence.
    const double SilentDb = -80;

    static readonly Assembly Resources = typeof(ClipPlayer).Assembly;

    /// <summary>The netlist that the Play clip button renders the clip through.</summary>
    [Parameter] public string Netlist { get; set; } = "";

    // A render that runs longer than this many seconds asks the user to cancel.
    const int SlowSeconds = 60;

    /// <summary>The clock for the elapsed time of a render. A test gives a fake clock.</summary>
    [Parameter] public TimeProvider Clock { get; set; } = TimeProvider.System;

    string sourceName = BundledName;
    double[]? uploaded;
    int uploadedRate;
    double[]? output;
    int outputRate;
    string status = "";
    bool busy;
    bool cancelled;
    long started;
    double done;
    double total;
    int oversample = 1;
    ITimer? ticker;
    IJSObjectReference? module;

    /// <summary>
    /// Renders the clip through the netlist in the worker, applies the cabinet IR, and plays the result.
    /// The clip is the upload, or the bundled clip. A failure shows in the status text and does not throw.
    /// </summary>
    public async Task Try(string netlist)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        cancelled = false;
        started = Clock.GetTimestamp();
        done = 0;
        status = "Rendering…";
        StateHasChanged();
        try
        {
            var (samples, rate) = uploaded is null ? Load("audio/clip.wav") : (uploaded, uploadedRate);
            total = (double)samples.Length / rate;
            ShowProgress();

            // NOTE: The status shows the elapsed time even when the worker reports nothing.
            ticker = Clock.CreateTimer(_ => _ = InvokeAsync(() => { ShowProgress(); StateHasChanged(); }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
            var (rendered, used) = await RenderWithRetry(netlist, samples, rate);

            // NOTE: A sample that is not finite plays as silence.
            double[] wet = [.. rendered.Select(sample => double.IsFinite(sample) ? sample : 0)];
            var (ir, irRate) = Load("audio/cab-1x12.wav");
            if (irRate == rate)
            {
                status = "Applying the cabinet IR…";
                StateHasChanged();
                wet = await Host.Convolve(wet, ir);
            }

            var (peak, rms) = Levels(wet);
            if (peak < SilentDb)
            {
                output = null;
                status = "The output is silent." + await Bias(netlist);
                return;
            }

            var levels = $"Output peak {peak:0.0} dBFS, RMS {rms:0} dBFS.";
            var how = irRate == rate ? "Playing with the cabinet IR." : $"Playing without the cabinet IR. The clip is {rate} Hz and the IR is {irRate} Hz.";
            status = (used > 1 ? $"Rendered at {used}x oversample. " : "") + how + " " + levels;
            output = wet;
            outputRate = rate;
            await (await Module()).InvokeVoidAsync("play", ToFloat32Bytes(wet), rate);
        }
        catch (OperationCanceledException)
        {
            status = "Cancelled.";
        }
        catch (Exception e)
        {
            status = cancelled ? "Cancelled." : "Render failed: " + e.Message;
        }
        finally
        {
            ticker?.Dispose();
            ticker = null;
            // NOTE: A parent calls Try from its own event, so the parent draws again and this player does not (#148).
            busy = false;
            StateHasChanged();
        }
    }

    // NOTE: A timestep or convergence failure can pass at a higher oversample. Any other failure is final.
    async Task<(double[] Samples, int Oversample)> RenderWithRetry(string netlist, double[] samples, int rate)
    {
        for (var i = 0; ; i++)
        {
            try
            {
                oversample = Oversamples[i];
                done = 0;
                ShowProgress();
                return (await Host.Render(netlist, samples, rate, oversample, OnProgress), oversample);
            }
            catch (Exception e) when (i < Oversamples.Length - 1 && IsSolverFailure(e))
            {
            }
        }
    }

    void OnProgress(double seconds) =>
        _ = InvokeAsync(() =>
        {
            done = seconds;
            ShowProgress();
            StateHasChanged();
        });

    // The status of a render that runs: the seconds done, and the question when it is slow.
    void ShowProgress()
    {
        if (!busy || cancelled)
        {
            return;
        }

        var elapsed = Clock.GetElapsedTime(started).TotalSeconds;
        status = $"Rendering {done:0.0} of {total:0.0} s at {oversample}x oversample."
            + (elapsed >= SlowSeconds ? $" This is slow. Load a shorter WAV file, or cancel. Elapsed {elapsed:0} s." : "");
    }

    void Cancel()
    {
        cancelled = true;
        status = "Cancelled.";
        Host.CancelRender();
    }

    public void Dispose() => ticker?.Dispose();

    static bool IsSolverFailure(Exception e) =>
        e.Message.Contains("timestep", StringComparison.OrdinalIgnoreCase)
        || e.Message.Contains("converge", StringComparison.OrdinalIgnoreCase)
        || e.Message.Contains("stepping failed", StringComparison.OrdinalIgnoreCase);

    static (double Peak, double Rms) Levels(double[] samples)
    {
        var peak = samples.Length == 0 ? 0 : samples.Max(Math.Abs);
        var rms = samples.Length == 0 ? 0 : Math.Sqrt(samples.Sum(x => x * x) / samples.Length);
        return (Db(peak), Db(rms));
    }

    static double Db(double amplitude) => amplitude <= 1e-12 ? -240 : 20 * Math.Log10(amplitude);

    // The first bias warning of the circuit, in words: its first sentence and its advice.
    async Task<string> Bias(string netlist)
    {
        try
        {
            var result = await Host.Run(netlist, new RunOptions());
            var message = result.Diagnostics
                .Select(d => d.Message)
                .FirstOrDefault(m => m.Contains(" is cut off.", StringComparison.Ordinal) || m.Contains(" is saturated.", StringComparison.Ordinal));
            if (message is null)
            {
                return "";
            }

            var sentences = message.Split(". ", StringSplitOptions.RemoveEmptyEntries);
            var advice = sentences[^1].TrimEnd('.');
            return sentences.Length > 1 ? $" {sentences[0]}. {advice}." : $" {message}";
        }
        catch (Exception)
        {
            // NOTE: The diagnostic is a hint. Without it the status still says the output is silent.
            return "";
        }
    }

    async Task Upload(InputFileChangeEventArgs e)
    {
        try
        {
            await using var file = e.File.OpenReadStream(MaxUploadBytes);
            using var memory = new MemoryStream();
            await file.CopyToAsync(memory);
            memory.Position = 0;
            (uploaded, uploadedRate) = Mono(Wav.Read(memory));
            sourceName = e.File.Name;
            status = "";
        }
        catch (Exception ex) when (ex is InvalidDataException or NotSupportedException or IOException or EndOfStreamException)
        {
            status = "Upload failed: " + ex.Message;
        }
    }

    async Task Download()
    {
        using var stream = new MemoryStream();
        Wav.Write(stream, new WavData(outputRate, [output!]), 16);
        await (await Module()).InvokeVoidAsync("download", "ssp-output.wav", stream.ToArray());
    }

    async Task<IJSObjectReference> Module() => module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/clip-player.js");

    static byte[] ToFloat32Bytes(double[] samples)
    {
        var bytes = new byte[samples.Length * sizeof(float)];
        for (var i = 0; i < samples.Length; i++)
        {
            BitConverter.TryWriteBytes(bytes.AsSpan(i * sizeof(float)), (float)samples[i]);
        }

        return bytes;
    }

    static (double[] Samples, int Rate) Load(string name)
    {
        using var stream = Resources.GetManifestResourceStream(name) ?? throw new InvalidOperationException($"Missing resource {name}.");
        return Mono(Wav.Read(stream));
    }

    // NOTE: The worker renders one channel. A stereo clip is the mean of its two channels.
    static (double[] Samples, int Rate) Mono(WavData wav) =>
        (wav.Channels.Length == 1
            ? wav.Channels[0]
            : [.. wav.Channels[0].Zip(wav.Channels[1], (left, right) => (left + right) / 2)],
         wav.SampleRate);
}
