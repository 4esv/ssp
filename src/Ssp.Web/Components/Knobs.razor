@using System.Globalization
@using Ssp.Core.Netlist
@using Ssp.Web.Schematic
@implements IDisposable
@inject TimeProvider Time

@if (knobs.Count > 0 || switches.Count > 0)
{
    <section class="knobs">
        <h2>Knobs</h2>
        <p class="panel-hint">Move a slider to change the part. The circuit runs again.</p>
        @for (var i = 0; i < knobs.Count; i++)
        {
            var index = i;
            var knob = knobs[index];
            <label class="knob">
                <span class="part">@knob.Part</span>
                <input type="range" min="0" max="1" step="0.01" value="@Number(knob.Position)" @oninput="e => Move(index, e)" />
                <span class="taper">@knob.Taper</span>
                <span class="position">@Percent(knob.Position)</span>
            </label>
        }
        @foreach (var (part, throws, position) in switches)
        {
            <div class="switch" role="group" aria-label="@part" data-part="@part">
                <span class="part">@part</span>
                @foreach (var at in Ssp.Core.Parts.Switch.Positions(throws))
                {
                    var to = at;
                    <button type="button" aria-pressed="@(to == position ? "true" : "false")" @onclick="() => Set(part, to)">@PositionName(throws, to)</button>
                }
            </div>
        }
    </section>
}
else
{
    <p class="panel-hint">No knobs. Add a line like "* ssp:knob RV1 log 0.5" to the netlist to get a slider for a pot.</p>
}

@code {
    /// <summary>The wait after the last slider change before the netlist changes.</summary>
    public static readonly TimeSpan DefaultDebounce = TimeSpan.FromMilliseconds(250);

    /// <summary>The netlist text. Each <c>knob</c> directive gives one slider.</summary>
    [Parameter] public string Netlist { get; set; } = "";

    /// <summary>Gets the netlist with the new knob positions, once for each burst of slider changes.</summary>
    [Parameter] public EventCallback<string> NetlistChanged { get; set; }

    [Parameter] public TimeSpan Debounce { get; set; } = DefaultDebounce;

    string? seen;
    List<KnobDirective> knobs = [];
    List<(string Part, int Throws, int Position)> switches = [];
    CancellationTokenSource? pending;

    protected override void OnParametersSet()
    {
        if (Netlist == seen)
        {
            return;
        }
        seen = Netlist;
        var directives = DirectiveParser.Parse(Netlist).Directives;
        knobs = directives.Knobs.ToList();
        // NOTE: The count of throws is the count of switch resistors, so a netlist with a switch is loaded.
        var circuit = directives.Switches.Count > 0 ? NetlistLoader.Load(Netlist) : null;
        switches = directives.Switches.Select(s => (s.Part, Throws: circuit is null ? 0 : Ssp.Core.Parts.Switch.Throws(circuit, s.Part), s.Position))
            .Where(s => s.Throws > 0).ToList();
    }

    void Move(int index, ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var position))
        {
            return;
        }
        knobs[index] = knobs[index] with { Position = position };

        pending?.Cancel();
        pending?.Dispose();
        pending = new CancellationTokenSource();
        _ = Fire(pending.Token);
    }

    async Task Fire(CancellationToken token)
    {
        try
        {
            await Task.Delay(Debounce, Time, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() => token.IsCancellationRequested ? Task.CompletedTask : NetlistChanged.InvokeAsync(WithPositions(Netlist, knobs)));
    }

    // NOTE: A switch button changes the netlist at once. A tap is one change, not a burst.
    async Task Set(string part, int position)
    {
        var set = SchematicEdits.SetSwitch(Netlist, part, position);
        if (set != Netlist) await NetlistChanged.InvokeAsync(set);
    }

    static string PositionName(int throws, int position) =>
        throws == 1 ? (position == 1 ? "On" : "Off") : position.ToString(CultureInfo.InvariantCulture);

    /// <summary>Writes the positions into the <c>knob</c> lines of the netlist, in order. Other lines do not change.</summary>
    static string WithPositions(string netlist, IReadOnlyList<KnobDirective> positions)
    {
        var lines = netlist.Split('\n');
        var next = 0;
        for (var i = 0; i < lines.Length && next < positions.Count; i++)
        {
            // NOTE: The parser decides which lines are knobs, so a malformed knob line keeps its text and gets no slider.
            if (DirectiveParser.Parse(lines[i]).Directives.Knobs.Count == 0)
            {
                continue;
            }
            var knob = positions[next++];
            var end = lines[i].EndsWith('\r') ? "\r" : "";
            lines[i] = $"* ssp:knob {knob.Part} {knob.Taper} {Number(knob.Position)}{end}";
        }
        return string.Join('\n', lines);
    }

    /// <summary>The resistance from the wiper to the bottom of a pot of <paramref name="total"/> ohms. An unknown taper is linear.</summary>
    public static double Resistance(string taper, double position, double total) => total * (Ssp.Core.Parts.Pot.Ratio(taper, position) ?? position);

    /// <summary>The name of a taper on the canvas: linear, audio (log) or reverse audio (revlog).</summary>
    public static string TaperName(string taper) => taper.ToLowerInvariant() switch
    {
        "log" => "audio",
        "revlog" => "reverse audio",
        _ => taper,
    };

    /// <summary>The netlist with a new position, 0 to 1, in the <c>knob</c> line of one part. Other lines do not change.</summary>
    public static string Turn(string netlist, string part, double position)
    {
        var knobs = DirectiveParser.Parse(netlist).Directives.Knobs
            .Select(k => string.Equals(k.Part, part, StringComparison.OrdinalIgnoreCase) ? k with { Position = Math.Round(Math.Clamp(position, 0, 1), 4) } : k)
            .ToList();
        return WithPositions(netlist, knobs);
    }

    static string Number(double value) => value.ToString("R", CultureInfo.InvariantCulture);

    static string Percent(double value) => value.ToString("0%", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        pending?.Cancel();
        pending?.Dispose();
    }
}
