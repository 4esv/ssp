@using System.Reflection
@implements IDisposable
@using Ssp.Core.Chains
@using Ssp.Core.Netlist

<CascadingValue Value="Choice">
<section class="virtual-amp">
    <h2>Virtual amp</h2>
    <p class="panel-hint">Pick a block for each stage, set the knobs, then press Try to hear the chain.</p>
    <label class="amp-pedal">
        <input type="checkbox" class="use-pedal" checked="@(pedalOn && pedalUsable)" disabled="@(!pedalUsable)" @onchange="UsePedal" />
        <span>Use my circuit as the pedal</span>
    </label>
    @if (!pedalUsable)
    {
        <p class="panel-hint">Add a Jack in and a Jack out to the drawing to use it here.</p>
    }
    <div class="amp-stack">
    @foreach (var section in Sections)
    {
        <label class="amp-stage">
            <span>@section.Label</span>
            <select data-stage="@section.Name" aria-label="@section.Label" value="@picks[section.Name]" @onchange="e => Pick(section.Name, e)">
                @foreach (var block in Blocks[section.Name])
                {
                    <option value="@block">@block</option>
                }
            </select>
        </label>
    }
    </div>

    <SamplePicker />

    <Knobs Netlist="@netlist" NetlistChanged="Tune" />

    <button type="button" class="amp-try" disabled="@(error is not null)" @onclick="Try">Try</button>
    <span class="amp-sample">Sample: @Choice.Name</span>
    <p class="amp-error" role="alert">@(error is null ? null : "The chain cannot be built. " + error)</p>
    <textarea class="amp-netlist" aria-label="Chain netlist" readonly rows="6">@netlist</textarea>

    <ClipPlayer @ref="player" Netlist="@netlist" Cache="Cache" ShowPicker="false" />
</section>
</CascadingValue>

@code {
    /// <summary>The choice of the editor. Without a cascading one, the panel keeps its own and shares it with its player.</summary>
    [CascadingParameter] public SampleChoice? Shared { get; set; }

    readonly SampleChoice ownChoice = new();
    SampleChoice Choice => Shared ?? ownChoice;
    SampleChoice? watched;

    sealed record Section(string Name, string Label);

    // NOTE: A block file name starts with the name of its section. The chain runs in this order.
    static readonly Section[] Sections = [new("gain", "Gain stage"), new("tone", "Tone stack"), new("power", "Power section")];

    /// <summary>The blocks of the preset chain. It loads on first open.</summary>
    public static readonly IReadOnlyDictionary<string, string> Preset = new Dictionary<string, string>
    {
        ["gain"] = "gain-variable-tl072.cir",
        ["tone"] = "tone-baxandall-passive.cir",
        ["power"] = "power-9v.cir",
    };

    static readonly Assembly Resources = typeof(VirtualAmp).Assembly;

    static readonly IReadOnlyDictionary<string, string[]> Blocks = Sections.ToDictionary(
        s => s.Name,
        s => Resources.GetManifestResourceNames()
            .Where(n => n.StartsWith("blocks/" + s.Name + "-", StringComparison.Ordinal) && n.EndsWith(".cir", StringComparison.Ordinal))
            .Select(n => n["blocks/".Length..])
            .Order(StringComparer.Ordinal)
            .ToArray());

    /// <summary>The netlist of the editor. With a Jack in and a Jack out it can be the first stage of the chain.</summary>
    [Parameter] public string? Pedal { get; set; }

    /// <summary>The renders to reuse. The editor gives the one that its Clip tab uses.</summary>
    [Parameter] public RenderCache? Cache { get; set; }

    bool pedalOn = true;
    bool pedalUsable;
    string? pedalSeen;

    readonly Dictionary<string, string> picks = Preset.ToDictionary(p => p.Key, p => p.Value);
    ClipPlayer? player;
    string netlist = "";
    string? error;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(watched, Choice))
        {
            if (watched is not null) watched.Changed -= Redraw;
            watched = Choice;
            watched.Changed += Redraw;
        }
        if (Pedal == pedalSeen && netlist.Length > 0)
        {
            return;
        }
        pedalSeen = Pedal;
        var directives = DirectiveParser.Parse(Pedal ?? "").Directives;
        var usable = directives.Input is not null && directives.Output is not null;
        // NOTE: A drawing that gets its jacks turns the pedal on. A box that the user cleared stays clear while the jacks stay.
        if (usable && !pedalUsable) pedalOn = true;
        pedalUsable = usable;
        Build();
    }

    void Redraw() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (watched is not null) watched.Changed -= Redraw;
    }

    void UsePedal(ChangeEventArgs e)
    {
        pedalOn = e.Value is true;
        Build();
    }

    void Pick(string section, ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { } block && Blocks[section].Contains(block))
        {
            picks[section] = block;
            Build();
        }
    }

    // NOTE: A new pick starts the chain again, so each knob goes back to its default position.
    void Build()
    {
        try
        {
            var stages = Sections.Select(s => new ChainStage(s.Name, Read(picks[s.Name])));
            if (pedalOn && pedalUsable) stages = stages.Prepend(new ChainStage("pedal", Pedal!));
            netlist = Chain.Compose([.. stages]);
            error = null;
        }
        catch (ArgumentException e)
        {
            error = e.Message;
        }
    }

    void Tune(string tuned) => netlist = tuned;

    async Task Try()
    {
        if (player is not null && error is null)
        {
            await player.Try(netlist);
        }
    }

    static string Read(string block)
    {
        using var stream = Resources.GetManifestResourceStream("blocks/" + block) ?? throw new InvalidOperationException($"Missing resource blocks/{block}.");
        using var reader = new StreamReader(stream);
        return reader.ReadToEnd();
    }
}
