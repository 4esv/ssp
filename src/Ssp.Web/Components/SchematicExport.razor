@using Ssp.Web.Editing
@using Ssp.Core.Netlist
@using System.Text
@using Microsoft.JSInterop
@inject IJSRuntime Js

@* NOTE: The button needs only a load. The SVG needs the placer, which is slow, so it is made on a click and not on each render. *@
@if (SchematicView.Drawable(Loads?.Load(Netlist) ?? NetlistLoader.Load(Netlist)))
{
    @* NOTE: The file is the same SVG that the schematic shows. A data URL needs no server. *@
    <button type="button" class="svg-download" title="Save the schematic as an SVG file" @onclick="Save">Download SVG</button>
}

@code {
    [Parameter] public string Netlist { get; set; } = "";

    /// <summary>The loads of the editor page. With none the panel loads the netlist itself.</summary>
    [CascadingParameter] public NetlistCache? Loads { get; set; }

    /// <summary>Saves the file, as the button does. Nothing happens when there is no schematic.</summary>
    public async Task Save()
    {
        if (SchematicView.Svg(Netlist) is { } svg)
        {
            await Download(svg);
        }
    }

    async Task Download(string svg)
    {
        await using var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
        await module.InvokeVoidAsync("save", "schematic.svg", DataUrl(svg));
    }

    static string DataUrl(string svg) => "data:image/svg+xml;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(svg));
}
