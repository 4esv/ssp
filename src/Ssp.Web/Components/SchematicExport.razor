@using System.Text

@if (SchematicView.Svg(Netlist) is { } svg)
{
    @* NOTE: A data URL needs no script and no server. The file is the same SVG that the schematic shows. *@
    <a class="svg-download" download="schematic.svg" href="@DataUrl(svg)">Download SVG</a>
}

@code {
    [Parameter] public string Netlist { get; set; } = "";

    static string DataUrl(string svg) => "data:image/svg+xml;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(svg));
}
