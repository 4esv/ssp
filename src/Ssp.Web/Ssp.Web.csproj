<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>Ssp.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- NOTE: [JSExport] in Hosting/WorkerExports.cs needs unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- NOTE: The app is static. The gallery reads the library circuits from the assembly. -->
    <EmbeddedResource Include="..\..\circuits\library\*" LogicalName="library/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\models\parts.toml" LogicalName="parts.toml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ssp.Core\Ssp.Core.csproj" />
  </ItemGroup>
</Project>
